// feathercheck, written in Nifla (Stone 25) — the
// toolchain's first self-made tool: the Stone 21 feather
// checker rewritten in the language itself, and compiled
// by niflac into a standalone program like any other.
//
// It reads a .feather file and answers in plain words
// whether its card is true — the name, what it needs, the
// byte count and checksum the card states, the byte count
// and checksum the program as it stands reckons to, and
// a clear verdict line. Its words are the hosted
// checker's words, line for line; run-selfmade.sh proves
// the two agree across the feather corpus.
//
// The craft the writing needed, named plainly:
//
//   - The file is read with readbytes (Stone 25's
//     addition to the toolbox): a feather's program bytes
//     are not text, and readfile honestly refuses them.
//
//   - A card line's bytes are read with astext
//     (Stone 28): the whole line decoded at once, the
//     way the hosted checker decodes it — a byte that
//     is not a letter stands as the replacement mark,
//     never dropped. Until Stone 28 the line's letters
//     were built one by one out of the printable
//     characters and the rest fell away, so the two
//     checkers printed different lines on such a card
//     (Stone 29 closes that edge; the corpus carries
//     the cards that prove it).
//
//   - The card's stated byte count is carried as its
//     digits, and compared as digits. The language's
//     numbers are exact only to 2^53, but a card may
//     state a count past that: the hosted checker reads
//     it as a machine whole number, exact to
//     9223372036854775807, and refuses a bigger one as
//     not a whole number — so this checker does the
//     same, in the same words, and prints the stated
//     digits as they stand (Stone 29 closes that edge
//     too).
//
//   - The FNV-1a-64 reckoning is done in 16-bit limbs.
//     Nifla's numbers are whole exactly up to 2^53, and a
//     64-bit hash times its prime is more than that, so
//     the hash is carried as four limbs of 16 bits each
//     and the multiplication is done limb by limb — every
//     product and carry stays small enough to be exact.
//     One small helper does work the language has no
//     single word for: floordiv reads a whole-number
//     quotient off a division's spoken form. (A byte's
//     XOR was the other such helper until Stone 27 gave
//     the toolbox bitxor; fnvstep calls it directly.)

// The whole-number quotient of n divided by d, for whole
// n >= 0 and d > 0. '/' gives the true quotient with its
// fraction, and the language has no rounding tool, so
// the whole part is read off the quotient's spoken form:
// for n >= d the quotient is at least 1 and speaks
// plainly (never in the e-notation small fractions use);
// for n < d the answer is 0, said directly.
make floordiv(n, d) {
    if n < d {
        give 0
    }
    let q = n / d
    let t = "" + q
    let dot = find(t, ".")
    if dot == -1 {
        give q
    }
    let whole = part(t, 0, dot)
    let v = 0
    let i = 0
    while i < length(whole) {
        v = v * 10 + find("0123456789", part(whole, i, 1))
        i = i + 1
    }
    give v
}

// One step of the FNV-1a-64 reckoning: h is the hash as
// four 16-bit limbs, little-endian ([l0, l1, l2, l3]),
// and b is the next byte. The byte is XORed into the
// low limb (bitxor, Stone 27's word for the work), then
// the hash is multiplied by the prime 0x100000001b3 —
// whose own limbs are 435, 0, 256, 0, so only two
// multiplications per limb are needed.
make fnvstep(h, b) {
    let low = h[0] - 256 * floordiv(h[0], 256)
    let h0 = h[0] - low + bitxor(low, b)
    let r0 = h0 * 435
    let c0 = floordiv(r0, 65536)
    let l0 = r0 - c0 * 65536
    let r1 = h[1] * 435 + c0
    let c1 = floordiv(r1, 65536)
    let l1 = r1 - c1 * 65536
    let r2 = h[2] * 435 + h0 * 256 + c1
    let c2 = floordiv(r2, 65536)
    let l2 = r2 - c2 * 65536
    let r3 = h[3] * 435 + h[1] * 256 + c2
    let l3 = r3 - floordiv(r3, 65536) * 65536
    give [l0, l1, l2, l3]
}

// The hash as sixteen lowercase hex letters, the way a
// card states it: each limb gives four letters.
make hexof(h) {
    let digits = "0123456789abcdef"
    let out = ""
    let li = 3
    while li >= 0 {
        let l = h[li]
        let d1 = floordiv(l, 4096)
        l = l - d1 * 4096
        let d2 = floordiv(l, 256)
        l = l - d2 * 256
        let d3 = floordiv(l, 16)
        let d4 = l - d3 * 16
        out = out + part(digits, d1, 1) + part(digits, d2, 1) + part(digits, d3, 1) + part(digits, d4, 1)
        li = li - 1
    }
    give out
}

// h * 16 + digit, limb by limb — how a stated checksum's
// letters are gathered into limbs for the comparison.
make shiftadd(h, digit) {
    let l3 = h[3] * 16 + floordiv(h[2], 4096)
    let l2 = (h[2] - 4096 * floordiv(h[2], 4096)) * 16 + floordiv(h[1], 4096)
    let l1 = (h[1] - 4096 * floordiv(h[1], 4096)) * 16 + floordiv(h[0], 4096)
    let l0 = (h[0] - 4096 * floordiv(h[0], 4096)) * 16 + digit
    give [l0, l1, l2, l3]
}

// The line of a block of bytes starting at 'start': its
// text, read with astext (Stone 28) the way the hosted
// checker reads it — a byte that is not a letter stands
// as the replacement mark — and where the next line
// begins. Gives an object with found = false when no
// newline remains in the block.
make lineat(block, start) {
    let total = length(block)
    let i = start
    while i < total {
        if block[i] == 10 {
            let line = makebytes(i - start)
            let j = start
            while j < i {
                line[j - start] = block[j]
                j = j + 1
            }
            give { found: true, text: astext(line), next: i + 1 }
        }
        i = i + 1
    }
    give { found: false, text: "", next: total }
}

// The refusal every damaged card gets: the line, and the
// program ends with the not-whole code.
make damaged(reason) {
    say "This is not a whole feather: " + reason
    exitwith(1)
}

// A whole number as its digits — how the program's own
// byte count is written, for the comparison against the
// card's stated digits. The count is a file's length,
// far inside the language's exact reach.
make digitsof(n) {
    if n == 0 {
        give "0"
    }
    let out = ""
    let m = n
    while m > 0 {
        let q = floordiv(m, 10)
        out = part("0123456789", m - q * 10, 1) + out
        m = q
    }
    give out
}

// Whether digit string 'a' stands greater than digit
// string 'b', for strings of one length: the first
// place they differ decides it, by the digits' own
// order. (Text itself can only be checked with == and
// != in this language; numbers have the < and > words.)
make digitsgreater(a, b) {
    let i = 0
    while i < length(a) {
        let da = find("0123456789", part(a, i, 1))
        let db = find("0123456789", part(b, i, 1))
        if da != db {
            give da > db
        }
        i = i + 1
    }
    give false
}

// The digits a card's 'bytes:' line states, with any
// leading zeros lifted — or the card is refused, in the
// hosted checker's words, when the line does not carry
// a whole number it can hold: any mark that is not a
// digit, or a count past 9223372036854775807, the
// machine whole number's reach. The reach is compared
// as digits — length first, then digit by digit —
// which for digit strings is the numbers' own order.
make stateddigits(tail) {
    if length(tail) == 0 {
        damaged("the card's 'bytes:' line does not carry a whole number.")
    }
    let ti = 0
    while ti < length(tail) {
        if find("0123456789", part(tail, ti, 1)) == -1 {
            damaged("the card's 'bytes:' line does not carry a whole number.")
        }
        ti = ti + 1
    }
    let digits = tail
    let lifting = true
    while lifting {
        if length(digits) <= 1 {
            lifting = false
        } else {
            if part(digits, 0, 1) == "0" {
                digits = part(digits, 1, length(digits) - 1)
            } else {
                lifting = false
            }
        }
    }
    if length(digits) > 19 {
        damaged("the card's 'bytes:' line does not carry a whole number.")
    }
    if length(digits) == 19 {
        if digitsgreater(digits, "9223372036854775807") {
            damaged("the card's 'bytes:' line does not carry a whole number.")
        }
    }
    give digits
}

// ---------- the check itself ----------

let args = arguments()
if length(args) != 1 {
    sayerr("Usage: feathercheck <file.feather>")
    exitwith(2)
}
let path = args[0]

let block = makebytes(0)
let read = true
attempt {
    block = readbytes(path)
} if it fails {
    read = false
}
if read == false {
    damaged("the file '" + path + "' could not be read.")
}
let total = length(block)

let first = lineat(block, 0)
if first.found == false {
    damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
}
if first.text != "CARDNULL FEATHER 1" {
    damaged("the card's first line is not CARDNULL FEATHER 1 — this file does not carry a feather's card.")
}

let name = ""
let hasName = false
let needs = ""
let hasNeeds = false
let statedDigits = ""
let hasBytes = false
let statedSumText = ""
let statedSum = [0, 0, 0, 0]
let hasSum = false
let programStart = -1

let p = first.next
let cardDone = false
while cardDone == false {
    if p >= total {
        cardDone = true
    } else {
        if block[p] == 10 {
            programStart = p + 1
            cardDone = true
        } else {
            let lb = lineat(block, p)
            if lb.found == false {
                damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
            }
            let line = lb.text
            if length(line) >= 6 {
                if part(line, 0, 6) == "name: " {
                    name = part(line, 6, length(line) - 6)
                    hasName = true
                }
            }
            if length(line) >= 7 {
                if part(line, 0, 7) == "needs: " {
                    needs = part(line, 7, length(line) - 7)
                    hasNeeds = true
                }
            }
            if length(line) >= 7 {
                if part(line, 0, 7) == "bytes: " {
                    statedDigits = stateddigits(part(line, 7, length(line) - 7))
                    hasBytes = true
                }
            }
            if length(line) >= 10 {
                if part(line, 0, 10) == "checksum: " {
                    let tail = part(line, 10, length(line) - 10)
                    if length(tail) != 16 {
                        damaged("the card's 'checksum:' line is not sixteen hex letters.")
                    }
                    let limbs = [0, 0, 0, 0]
                    let ti = 0
                    while ti < 16 {
                        let v = find("0123456789abcdefABCDEF", part(tail, ti, 1))
                        if v == -1 {
                            damaged("the card's 'checksum:' line is not sixteen hex letters.")
                        }
                        let d = v
                        if v >= 16 {
                            d = v - 6
                        }
                        limbs = shiftadd(limbs, d)
                        ti = ti + 1
                    }
                    statedSumText = tail
                    statedSum = limbs
                    hasSum = true
                }
            }
            p = lb.next
        }
    }
}

if programStart == -1 {
    damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
}
if hasName == false {
    damaged("the card has no 'name:' line.")
}
if hasNeeds == false {
    damaged("the card has no 'needs:' line.")
}
if hasBytes == false {
    damaged("the card has no 'bytes:' line, so the program's length cannot be checked.")
}
if hasSum == false {
    damaged("the card has no 'checksum:' line, so the program's wholeness cannot be checked.")
}

// The reckoning: FNV-1a-64 over the program bytes, from
// the offset basis 0xcbf29ce484222325 — in limbs,
// [8997, 33826, 40164, 52210].
let h = [8997, 33826, 40164, 52210]
let i = programStart
while i < total {
    h = fnvstep(h, block[i])
    i = i + 1
}
let reckonedText = hexof(h)
let programBytes = total - programStart

say "Feather: " + name
say "Needs: " + needs
say "The card says the program is " + statedDigits + " bytes, with checksum " + statedSumText + "."
say "The program as it stands is " + programBytes + " bytes, with checksum " + reckonedText + "."

let cardTrue = false
if digitsof(programBytes) == statedDigits {
    if h[0] == statedSum[0] {
        if h[1] == statedSum[1] {
            if h[2] == statedSum[2] {
                if h[3] == statedSum[3] {
                    cardTrue = true
                }
            }
        }
    }
}
if cardTrue {
    say "The card is true: the program is whole, and a door may let this feather in."
    exitwith(0)
}
say "The card is not true: the program does not match its card, so a door must refuse this feather."
exitwith(1)
