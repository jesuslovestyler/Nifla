// Nifla in Nifla — an interpreter for the Nifla language, written
// in Nifla itself (Stone 8, the self-hosting stone).
//
// Run it the way the Swift interpreter runs a program:
//
//     nifla-in-nifla program.nifla [words for the program...]
//
// It reads the program with readfile, takes it apart with its own
// lexer and parser, and runs it with its own interpreter — the
// same plain-words errors, the same guards, the same output as
// the Swift interpreter gives, on every program it covers. (The
// README's Stone 8 section names exactly what it covers. Stone 8
// also named two differences it couldn't help — errors spoken on
// the screen instead of the error channel, and file failures
// inside the interpreted program escaping uncatchably. Stone 10
// closed both: Nifla grew an error channel, exit codes, and
// 'attempt', and this interpreter now uses all three, so its
// behavior matches the Swift interpreter on those cases too.)
//
// How values are held: Nifla can't build field names out of text
// at run time, so everything structured is a tagged object whose
// fields were named when this program was written, and anything
// with names made at run time — an interpreted object's fields, a
// scope's variables — is two lists walking side by side: a list
// of names and a list of values, in the same order.
//
// An interpreted value is one of:
//   { kind: "number", num: the number }
//   { kind: "text", text: the text }
//   { kind: "boolean", flag: true or false }
//   { kind: "object", names: [field names], values: [field values] }
//   { kind: "list", items: [the values] }
//   { kind: "bytes", data: [the bytes, as host numbers] }
//   { kind: "nothing" } — the empty value (Stone 19): what
//   the word 'nothing' stands for, what a 'maybe' variable
//   holds when it holds nothing, and what a function that
//   never 'give's hands back inside this interpreter.
//
// Every lexer, parser, and interpreter function hands back a
// result instead of failing — Nifla has no errors to throw:
//   { ok: true, value: ... }        — it worked
//   { ok: false, message: "..." }   — the plain-words error,
//                                     already wearing its "Line N:"
//                                     (it also carries "bare", the
//                                     message without the prefix,
//                                     and "line" — Stone 10's
//                                     'attempt' needs the bare
//                                     words for its 'problem')
// A statement's result also carries "gave": true when a 'give'
// line ended the function it was running in.

// ---------- small shared helpers ----------

// The one "nothing" value, made once and shared.
let NOTHING = { kind: "nothing" }

// Stone 19: the words that follow an operation's refusal when
// one side was the empty value — the same text the Swift
// interpreter speaks (its nothingNote).
let NOTHINGNOTE = " Nothing is the empty value: there is nothing there to work with. If a value might be nothing, check it first — if value == nothing { ... } else { ... } — and use it in the 'else', where it is known to be there."

make errAt(line, message) {
    give { ok: false, message: "Line " + line + ": " + message, bare: message, line: line }
}

make okVal(value) {
    give { ok: true, value: value }
}

// A copy of a list, so a walk that adds to the copy leaves the
// original as it was.
make copyList(list) {
    let out = []
    for item in list {
        append(out, item)
    }
    give out
}

// Is this character a digit, a letter, or the start of a name?
make isDigitCh(c) {
    give find("0123456789", c) >= 0
}

make digitVal(c) {
    give find("0123456789", c)
}

make isLetterCh(c) {
    give find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c) >= 0
}

make isNameCh(c) {
    if isLetterCh(c) {
        give true
    }
    if isDigitCh(c) {
        give true
    }
    give c == "_"
}

// A number written the way Nifla writes numbers for people — the
// host's own rendering, reached by joining the number onto text.
make numText(n) {
    give "" + n
}

// Is this number a whole number? Told from how it writes out:
// whole numbers under 1e15 write with no point and no exponent.
make isWholeNum(n) {
    let s = numText(n)
    if find(s, ".") >= 0 {
        give false
    }
    if find(s, "e") >= 0 {
        give false
    }
    if find(s, "E") >= 0 {
        give false
    }
    give true
}

// A number built out of digit text, the lexer's way: fold the
// digits in, ten at a time; a point splits whole from fraction.
make textToNumber(t) {
    let dot = find(t, ".")
    if dot < 0 {
        let v = 0
        for c in t {
            v = v * 10 + digitVal(c)
        }
        give v
    }
    let whole = 0
    let wholeText = part(t, 0, dot)
    for c in wholeText {
        whole = whole * 10 + digitVal(c)
    }
    let frac = 0
    let fracText = part(t, dot + 1, length(t) - dot - 1)
    for c in fracText {
        frac = frac * 10 + digitVal(c)
    }
    let scale = 1
    repeat length(fracText) {
        scale = scale * 10
    }
    give whole + frac / scale
}

// The whole number at or below n, and the one at or above — for
// the 'repeat' fraction message, which names both neighbours.
make floorNum(n) {
    if isWholeNum(n) {
        give n
    }
    let s = numText(n)
    if s[0] == "-" {
        give 0 - (textToNumber(part(s, 1, find(s, ".") - 1)) + 1)
    }
    give textToNumber(part(s, 0, find(s, ".")))
}

make ceilNum(n) {
    if isWholeNum(n) {
        give n
    }
    let s = numText(n)
    if s[0] == "-" {
        give 0 - textToNumber(part(s, 1, find(s, ".") - 1))
    }
    give textToNumber(part(s, 0, find(s, "."))) + 1
}

// Edit distance between two words, for "Did you mean" kindness —
// the same measure the Swift interpreter uses.
make editDistance(a, b) {
    let ac = []
    for c in a {
        append(ac, c)
    }
    let bc = []
    for c in b {
        append(bc, c)
    }
    if length(ac) == 0 {
        give length(bc)
    }
    if length(bc) == 0 {
        give length(ac)
    }
    let prev = []
    let i0 = 0
    while i0 <= length(bc) {
        append(prev, i0)
        i0 = i0 + 1
    }
    let i = 1
    while i <= length(ac) {
        let cur = [i]
        let j = 1
        while j <= length(bc) {
            let cost = 1
            if ac[i - 1] == bc[j - 1] {
                cost = 0
            }
            let best = prev[j] + 1
            if cur[j - 1] + 1 < best {
                best = cur[j - 1] + 1
            }
            if prev[j - 1] + cost < best {
                best = prev[j - 1] + cost
            }
            append(cur, best)
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    give prev[length(bc)]
}

// The closest name to `name` among `candidates`, when one is
// within edit distance 2 — as { found: true, name: ... }.
make closestOf(name, candidates) {
    let bestName = ""
    let bestDist = 3
    for candidate in candidates {
        if candidate != name {
            let d = editDistance(name, candidate)
            if d < bestDist {
                bestDist = d
                bestName = candidate
            }
        }
    }
    if bestDist <= 2 {
        give { found: true, name: bestName }
    }
    give { found: false, name: "" }
}

// ---------- interpreted values ----------

make vNumber(n) {
    give { kind: "number", num: n }
}

make vText(t) {
    give { kind: "text", text: t }
}

make vBool(b) {
    give { kind: "boolean", flag: b }
}

make vObject() {
    give { kind: "object", names: [], values: [] }
}

make vList(items) {
    give { kind: "list", items: items }
}

// A block of bytes (Stone 9): the bytes themselves are held as
// a list of host numbers, each a whole number from 0 to 255.
// The value is shared, the way lists and objects are.
make vBytes(data) {
    give { kind: "bytes", data: data }
}

// Where a name lives in a names list, or -1 when it isn't there.
make nameIndex(names, name) {
    let i = 0
    while i < length(names) {
        if names[i] == name {
            give i
        }
        i = i + 1
    }
    give -1
}

// An object's field read: { found, value }.
make objGet(obj, name) {
    let i = nameIndex(obj.names, name)
    if i < 0 {
        give { found: false, value: NOTHING }
    }
    give { found: true, value: obj.values[i] }
}

// An object's field set: an existing field keeps its place; a
// new one is added at the end. The object itself is shared, so
// the change is seen by everyone holding it.
make objSet(obj, name, value) {
    let i = nameIndex(obj.names, name)
    if i < 0 {
        append(obj.names, name)
        append(obj.values, value)
    } else {
        obj.values[i] = value
    }
}

// How a value is shown by 'say' — the renderer. `seen` holds the
// containers already being listed on the way here, so one that
// contains itself stops at "..." instead of listing forever.
// Inside a listing, text wears quotes.
make renderValue(v, seen, quoted) {
    if v.kind == "number" {
        give numText(v.num)
    }
    if v.kind == "text" {
        if quoted {
            give "\"" + v.text + "\""
        }
        give v.text
    }
    if v.kind == "boolean" {
        if v.flag {
            give "true"
        }
        give "false"
    }
    if v.kind == "object" {
        for s in seen {
            if s == v {
                give "..."
            }
        }
        if length(v.names) == 0 {
            give "{ }"
        }
        let inner = copyList(seen)
        append(inner, v)
        let parts = []
        let i = 0
        while i < length(v.names) {
            append(parts, v.names[i] + ": " + renderValue(v.values[i], inner, true))
            i = i + 1
        }
        give "{ " + join(parts, ", ") + " }"
    }
    if v.kind == "list" {
        for s in seen {
            if s == v {
                give "..."
            }
        }
        if length(v.items) == 0 {
            give "[]"
        }
        let inner = copyList(seen)
        append(inner, v)
        let parts = []
        for item in v.items {
            append(parts, renderValue(item, inner, true))
        }
        give "[" + join(parts, ", ") + "]"
    }
    if v.kind == "bytes" {
        let parts = []
        for b in v.data {
            append(parts, numText(b))
        }
        give "bytes(" + join(parts, ", ") + ")"
    }
    if v.kind == "nothing" {
        give "nothing"
    }
    give ""
}

// How a value is described inside an error message.
make described(v) {
    if v.kind == "number" {
        give "the number " + numText(v.num)
    }
    if v.kind == "text" {
        give "the text \"" + v.text + "\""
    }
    if v.kind == "boolean" {
        if v.flag {
            give "true"
        }
        give "false"
    }
    if v.kind == "object" {
        if length(v.names) == 0 {
            give "an object with no fields yet"
        }
        give "an object with the fields " + join(v.names, ", ")
    }
    if v.kind == "list" {
        if length(v.items) == 0 {
            give "an empty list"
        }
        if length(v.items) == 1 {
            give "a list of 1 item"
        }
        give "a list of " + length(v.items) + " items"
    }
    if v.kind == "bytes" {
        if length(v.data) == 0 {
            give "an empty block of bytes"
        }
        if length(v.data) == 1 {
            give "a block of 1 byte"
        }
        give "a block of " + length(v.data) + " bytes"
    }
    if v.kind == "nothing" {
        give "nothing"
    }
    give ""
}

// Stone 19: whether a kind word is a 'maybe' word —
// 'maybe ' standing before a kind.
make isMaybeKindWord(word) {
    if length(word) > 6 {
        give part(word, 0, 6) == "maybe "
    }
    give false
}

// Stone 18: how a kind word is spoken of in a guard's
// message — the same phrases the Swift checker uses.
// Stone 19: a 'maybe' word is spoken as the kind it names,
// or nothing.
make kindPhrase(word) {
    if isMaybeKindWord(word) {
        give kindPhrase(part(word, 6, length(word) - 6)) + " or nothing"
    }
    if word == "number" {
        give "a number"
    }
    if word == "text" {
        give "some text"
    }
    if word == "boolean" {
        give "a true/false value"
    }
    if word == "list" {
        give "a list"
    }
    if word == "object" {
        give "an object"
    }
    if word == "bytes" {
        give "a block of bytes"
    }
    give "nothing"
}

// Stone 18: whether a value satisfies an annotation. A
// value's own kind answers to the same word (see the value
// makers above); 'nothing' is satisfied only by no value.
// Stone 19: a 'maybe' mark is satisfied by the kind it
// names, and by the empty value.
make kindSatisfies(word, v) {
    if word == "nothing" {
        give v.kind == "nothing"
    }
    if isMaybeKindWord(word) {
        if v.kind == "nothing" {
            give true
        }
        give v.kind == part(word, 6, length(word) - 6)
    }
    give v.kind == word
}

// What 'say' shows for a value, at the top level.
make spokenOf(v) {
    give renderValue(v, [], false)
}

// ---------- scopes ----------
// A scope: { names: [...], values: [...], parent: a scope or
// NOTHING }. Names made inside a block stay inside it; setting a
// variable reaches the scope that made it.

make makeScope(parent) {
    give { kind: "scope", names: [], values: [], parent: parent, annNames: [], annWords: [] }
}

make scopeLookup(scope, name) {
    let here = scope
    while here.kind != "nothing" {
        let i = nameIndex(here.names, name)
        if i >= 0 {
            give { found: true, value: here.values[i] }
        }
        here = here.parent
    }
    give { found: false, value: NOTHING }
}

make scopeDeclaredHere(scope, name) {
    give nameIndex(scope.names, name) >= 0
}

make scopeDeclare(scope, name, value) {
    append(scope.names, name)
    append(scope.values, value)
}

// Stone 18: remembers the kind annotation a variable was
// made with, in the scope that made it — the runtime guard's
// memory of the promise.
make scopeDeclareAnnotation(scope, name, word) {
    append(scope.annNames, name)
    append(scope.annWords, word)
}

// The annotation a variable was made with, looked up through
// the scopes around it; "" when it was made with none.
make scopeAnnotation(scope, name) {
    let here = scope
    while here.kind != "nothing" {
        let i = nameIndex(here.annNames, name)
        if i >= 0 {
            give here.annWords[i]
        }
        here = here.parent
    }
    give ""
}

// Sets the variable in whichever scope made it; gives back
// whether any scope knew the name.
make scopeAssign(scope, name, value) {
    let here = scope
    while here.kind != "nothing" {
        let i = nameIndex(here.names, name)
        if i >= 0 {
            here.values[i] = value
            give true
        }
        here = here.parent
    }
    give false
}

// Every name visible from here, for "Did you mean" suggestions.
make scopeAllNames(scope) {
    let out = []
    let here = scope
    while here.kind != "nothing" {
        for n in here.names {
            append(out, n)
        }
        here = here.parent
    }
    give out
}

// ---------- the lexer ----------
// Turns the program's text into tokens, remembering the line
// each came from. The state walks the text as a list of
// one-character texts.

let gChars = []
let gPos = 0
let gLine = 1

// Tokens already lexed and waiting their turn (Stone 9): a
// floor block handed values reads its "( ... )" first and then
// captures its raw lines, so the tokens inside the parentheses
// are lexed early and handed out one by one from here.
let gPending = []

make lexPeek() {
    if gPos < length(gChars) {
        give gChars[gPos]
    }
    give ""
}

make lexPeek2() {
    if gPos + 1 < length(gChars) {
        give gChars[gPos + 1]
    }
    give ""
}

// The carriage-return character, held in a text of its own. It
// is written here as the character itself, between the quotes,
// because Nifla text has no escape for it.
let CRCHAR = ""

make isSpaceCh(c) {
    if c == " " {
        give true
    }
    if c == "\t" {
        give true
    }
    if c == CRCHAR {
        give true
    }
    give false
}

// Text with spaces and tabs trimmed off both ends — for telling
// a floor block's closing line from an instruction.
make trimSpaceLine(t) {
    let lo = 0
    let scanning = true
    while scanning {
        if lo >= length(t) {
            scanning = false
        }
        if scanning {
            if isSpaceCh(t[lo]) {
                lo = lo + 1
            } else {
                scanning = false
            }
        }
    }
    let hi = length(t)
    scanning = true
    while scanning {
        if hi <= lo {
            scanning = false
        }
        if scanning {
            if isSpaceCh(t[hi - 1]) {
                hi = hi - 1
            } else {
                scanning = false
            }
        }
    }
    give part(t, lo, hi - lo)
}

make isKeywordWord(w) {
    let words = ["let", "say", "if", "else", "while", "repeat", "for", "in", "make", "give", "true", "false", "floor", "attempt", "nothing"]
    for word in words {
        if word == w {
            give true
        }
    }
    give false
}

// Takes the whole program's text apart into tokens:
// { ok: true, value: [tokens] }, or the lexer's plain-words error.
make lexAll(source) {
    gChars = []
    for c in source {
        append(gChars, c)
    }
    gPos = 0
    gLine = 1
    let tokens = []
    let done = false
    while done == false {
        let r = lexOne()
        if r.ok == false {
            give r
        }
        append(tokens, r.value)
        if r.value.kind == "end" {
            done = true
        }
    }
    give okVal(tokens)
}

// One token, from wherever the lexer stands.
make lexOne() {
    if length(gPending) > 0 {
        let waiting = gPending[0]
        removeat(gPending, 0)
        give okVal(waiting)
    }
    // Skip spaces and blank lines; remember line numbers.
    let skipping = true
    while skipping {
        let c = lexPeek()
        if c == "\n" {
            gLine = gLine + 1
            gPos = gPos + 1
        } else {
            if isSpaceCh(c) {
                gPos = gPos + 1
            } else {
                skipping = false
            }
        }
    }
    let startLine = gLine
    let c = lexPeek()
    if c == "" {
        give okVal({ kind: "end", line: startLine })
    }
    // A // comment runs to the end of the line.
    if c == "/" {
        if lexPeek2() == "/" {
            let eating = true
            while eating {
                let ch = lexPeek()
                if ch == "\n" {
                    eating = false
                }
                if ch == "" {
                    eating = false
                }
                if eating {
                    gPos = gPos + 1
                }
            }
            give lexOne()
        }
    }
    if isDigitCh(c) {
        give lexNumberTok(startLine)
    }
    if c == "\"" {
        give lexTextTok(startLine)
    }
    if isNameCh(c) {
        if isDigitCh(c) == false {
            give lexWordTok(startLine)
        }
    }
    // Two-character symbols first, so "=" and "==" stay distinct.
    let pair = c + lexPeek2()
    if pair == "==" {
        gPos = gPos + 2
        give okVal({ kind: "symbol", symbol: pair, line: startLine })
    }
    if pair == "!=" {
        gPos = gPos + 2
        give okVal({ kind: "symbol", symbol: pair, line: startLine })
    }
    if pair == "<=" {
        gPos = gPos + 2
        give okVal({ kind: "symbol", symbol: pair, line: startLine })
    }
    if pair == ">=" {
        gPos = gPos + 2
        give okVal({ kind: "symbol", symbol: pair, line: startLine })
    }
    if pair == "->" {
        gPos = gPos + 2
        give okVal({ kind: "symbol", symbol: pair, line: startLine })
    }
    if find("+-*/(){}[]=<>.,:", c) >= 0 {
        gPos = gPos + 1
        give okVal({ kind: "symbol", symbol: c, line: startLine })
    }
    if c == "!" {
        give errAt(startLine, "I found a '!' on its own. To say 'not equal', write '!=' — an exclamation mark followed by an equals sign.")
    }
    give errAt(startLine, "I don't understand the character '" + c + "'. Nifla programs are made of words, numbers, text in \"quotes\", and the signs + - * / ( ) { } [ ] , . : = == != < <= > >=.")
}

make lexNumberTok(startLine) {
    let text = ""
    let eating = true
    while eating {
        let c = lexPeek()
        if isDigitCh(c) {
            text = text + c
            gPos = gPos + 1
        } else {
            eating = false
        }
    }
    // A decimal point counts only when a digit follows it.
    if lexPeek() == "." {
        if isDigitCh(lexPeek2()) {
            text = text + "."
            gPos = gPos + 1
            eating = true
            while eating {
                let c = lexPeek()
                if isDigitCh(c) {
                    text = text + c
                    gPos = gPos + 1
                } else {
                    eating = false
                }
            }
        }
    }
    give okVal({ kind: "number", num: textToNumber(text), line: startLine })
}

make lexTextTok(startLine) {
    gPos = gPos + 1  // the opening quote
    let value = ""
    let eating = true
    while eating {
        let c = lexPeek()
        if c == "" {
            eating = false
            give errAt(startLine, "This text never ends. Add a closing \" to finish it.")
        }
        if c == "\"" {
            gPos = gPos + 1
            eating = false
            give okVal({ kind: "text", text: value, line: startLine })
        }
        if c == "\n" {
            eating = false
            give errAt(startLine, "This text never ends — it runs into the end of the line. Add a closing \" to finish it.")
        }
        if c == "\\" {
            gPos = gPos + 1
            let esc = lexPeek()
            if esc == "" {
                eating = false
                give errAt(startLine, "This text never ends. Add a closing \" to finish it.")
            }
            if esc == "n" {
                value = value + "\n"
            } else {
                if esc == "t" {
                    value = value + "\t"
                } else {
                    if esc == "\"" {
                        value = value + "\""
                    } else {
                        if esc == "\\" {
                            value = value + "\\"
                        } else {
                            eating = false
                            give errAt(startLine, "I don't know the escape '\\" + esc + "' inside text. The ones I know are \\n (new line), \\t (tab), \\\" (a quote), and \\\\ (a backslash).")
                        }
                    }
                }
            }
            gPos = gPos + 1
        } else {
            value = value + c
            gPos = gPos + 1
        }
    }
    give errAt(startLine, "This text never ends. Add a closing \" to finish it.")
}

make lexWordTok(startLine) {
    let word = ""
    let eating = true
    while eating {
        let c = lexPeek()
        if isNameCh(c) {
            word = word + c
            gPos = gPos + 1
        } else {
            eating = false
        }
    }
    if word == "floor" {
        // A floor block: 'floor' followed on the same line by '{'
        // opens a stretch of raw lines — processor instructions,
        // taken exactly as written — until a line holding only
        // '}'. Those lines are never lexed as Nifla. Since Stone
        // 9 the block can be handed values first: 'floor' then
        // '( ... )' then '{'. The values are ordinary Nifla, so
        // their tokens are lexed now and wait in gPending behind
        // the 'floor' keyword token this gives back.
        let savedPos = gPos
        let skipping = true
        while skipping {
            let c = lexPeek()
            if c == " " {
                gPos = gPos + 1
            } else {
                if c == "\t" {
                    gPos = gPos + 1
                } else {
                    skipping = false
                }
            }
        }
        if lexPeek() == "(" {
            gPos = gPos + 1  // the '('
            let handed = [{ kind: "symbol", symbol: "(", line: startLine }]
            let depth = 1
            let collecting = true
            while collecting {
                let r = lexOne()
                if r.ok == false {
                    give r
                }
                if r.value.kind == "end" {
                    give errAt(startLine, "The '(' after 'floor' is never closed. Close the values being handed to the block with ')', then give the block itself: floor(values) { ... }.")
                }
                append(handed, r.value)
                if r.value.kind == "symbol" {
                    if r.value.symbol == "(" {
                        depth = depth + 1
                    }
                    if r.value.symbol == ")" {
                        depth = depth - 1
                    }
                }
                if depth == 0 {
                    collecting = false
                }
            }
            skipping = true
            while skipping {
                let c = lexPeek()
                if c == " " {
                    gPos = gPos + 1
                } else {
                    if c == "\t" {
                        gPos = gPos + 1
                    } else {
                        skipping = false
                    }
                }
            }
            if lexPeek() != "{" {
                give errAt(gLine, "After the values handed to 'floor' I need the block itself: '{' on the same line, then the processor instructions on the lines below, until a line holding only '}'.")
            }
            gPos = gPos + 1  // the '{'
            let rest = lexFloorRest(startLine)
            if rest.ok == false {
                give rest
            }
            for t in handed {
                append(gPending, t)
            }
            append(gPending, rest.value)
            give okVal({ kind: "keyword", word: "floor", line: startLine })
        }
        if lexPeek() == "{" {
            gPos = gPos + 1  // the '{'
            give lexFloorRest(startLine)
        }
        gPos = savedPos
    }
    if isKeywordWord(word) {
        give okVal({ kind: "keyword", word: word, line: startLine })
    }
    give okVal({ kind: "name", name: word, line: startLine })
}

// The rest of a floor block, once its '{' has been read: an
// optional comment, then the raw lines, one per line, until a
// line holding only '}'. Gives back the floor token.
make lexFloorRest(startLine) {
    let skipping = true
    while skipping {
        let c = lexPeek()
        if c == " " {
            gPos = gPos + 1
        } else {
            if c == "\t" {
                gPos = gPos + 1
            } else {
                skipping = false
            }
        }
    }
    if lexPeek() == "/" {
        if lexPeek2() == "/" {
            let eatingComment = true
            while eatingComment {
                let ch = lexPeek()
                if ch == "\n" {
                    eatingComment = false
                }
                if ch == "" {
                    eatingComment = false
                }
                if eatingComment {
                    gPos = gPos + 1
                }
            }
        }
    }
    if lexPeek() == "\n" {
        gPos = gPos + 1
        gLine = gLine + 1
    } else {
        if lexPeek() != "" {
            give errAt(startLine, "After 'floor {' the processor instructions go on the lines below it, one per line, until a line holding only '}'. Take anything else off this line.")
        }
    }
    let asmLines = []
    let capturing = true
    while capturing {
        if lexPeek() == "" {
            give errAt(startLine, "This 'floor' block is never closed. Add a line holding only '}' to finish it.")
        }
        let lineText = ""
        let eatingLine = true
        while eatingLine {
            let ch = lexPeek()
            if ch == "\n" {
                eatingLine = false
            }
            if ch == "" {
                eatingLine = false
            }
            if eatingLine {
                lineText = lineText + ch
                gPos = gPos + 1
            }
        }
        if lexPeek() == "\n" {
            gPos = gPos + 1
            gLine = gLine + 1
        }
        if trimSpaceLine(lineText) == "}" {
            capturing = false
        } else {
            append(asmLines, lineText)
        }
    }
    give okVal({ kind: "floor", asm: join(asmLines, "\n"), line: startLine })
}

// ---------- the parser ----------
// Reads the tokens and builds a tree of statements and
// expressions, as tagged objects:
//   statements: { type: "declare", name, kindWord, value, line }
//               { type: "assign", name, value, line }
//               { type: "assignTarget", target, value, line }
//               { type: "say", value, line }
//               { type: "if", condition, thenStmts, elseStmts, hasElse, line }
//               { type: "while", condition, body, line }
//               { type: "repeat", count, body, line }
//               { type: "for", name, over, body, line }
//               { type: "define", name, params, paramKinds, returnKind, body, line }
//               { type: "give", value, line }
//               { type: "attempt", body, recovery, line }
//               { type: "doCall", name, args, line }
//               { type: "doExpr", expr, line }
//   expressions: { type: "number", value, line }
//               { type: "text", value, line }
//               { type: "boolean", flag, line }
//               { type: "variable", name, line }
//               { type: "call", name, args, line }
//               { type: "object", names, values, line }
//               { type: "list", items, line }
//               { type: "field", base, name, line }
//               { type: "index", base, index, line }
//               { type: "floor", asm, args, line }
//               { type: "negate", inner, line }
//               { type: "binary", op, left, right, line }

let gToks = []
let gP = 0

make pCur() {
    give gToks[gP]
}

make pNext() {
    if gP + 1 < length(gToks) {
        give gToks[gP + 1]
    }
    give gToks[gP]
}

make pAdvance() {
    if gP < length(gToks) - 1 {
        gP = gP + 1
    }
}

make pIsSym(s) {
    let t = pCur()
    if t.kind == "symbol" {
        give t.symbol == s
    }
    give false
}

make pIsKw(w) {
    let t = pCur()
    if t.kind == "keyword" {
        give t.word == w
    }
    give false
}

// How a token reads in an error message.
make pSpoken(t) {
    if t.kind == "number" {
        give "the number " + numText(t.num)
    }
    if t.kind == "text" {
        give "the text \"" + t.text + "\""
    }
    if t.kind == "name" {
        give "the name '" + t.name + "'"
    }
    if t.kind == "keyword" {
        give "'" + t.word + "'"
    }
    if t.kind == "symbol" {
        give "'" + t.symbol + "'"
    }
    if t.kind == "floor" {
        give "a 'floor' block"
    }
    give "the end of the program"
}

make parseProgramAll(tokens) {
    gToks = tokens
    gP = 0
    let stmts = []
    let going = true
    while going {
        if pCur().kind == "end" {
            going = false
        }
        if going {
            let r = parseStatement()
            if r.ok == false {
                give r
            }
            append(stmts, r.value)
        }
    }
    give okVal(stmts)
}

make parseBlock(openLine) {
    let stmts = []
    let going = true
    while going {
        if pIsSym("}") {
            going = false
        }
        if going {
            if pCur().kind == "end" {
                give errAt(openLine, "This '{' is never closed. Add a '}' to finish the block it starts.")
            }
            let r = parseStatement()
            if r.ok == false {
                give r
            }
            append(stmts, r.value)
        }
    }
    pAdvance()  // the closing '}'
    give okVal(stmts)
}

// Stone 18: reads one kind word where an annotation puts
// one — after a ':' in a 'let' or a 'make', or after the
// arrow of a 'make'. The words are the checker's own kind
// vocabulary; anything else is refused in plain words, in
// the Swift parser's own wording.
make isKindWord(word) {
    if word == "number" {
        give true
    }
    if word == "text" {
        give true
    }
    if word == "boolean" {
        give true
    }
    if word == "list" {
        give true
    }
    if word == "object" {
        give true
    }
    if word == "bytes" {
        give true
    }
    if word == "nothing" {
        give true
    }
    give false
}

make parseKindWord(after) {
    let t = pCur()
    // Stone 19: 'nothing' is a word of the language now, so
    // it arrives as a keyword token, not a name — it is a
    // kind word all the same, in the plain position.
    if t.kind == "keyword" {
        if t.word == "nothing" {
            pAdvance()
            give okVal("nothing")
        }
    }
    if t.kind != "name" {
        give errAt(t.line, "After the " + after + " I need a kind — one of: number, text, boolean, list, object, bytes, nothing. Instead I found " + pSpoken(t) + ".")
    }
    let word = t.name
    // Stone 19: 'maybe' may stand before a kind.
    if word == "maybe" {
        pAdvance()
        let t2 = pCur()
        if t2.kind == "keyword" {
            if t2.word == "nothing" {
                give errAt(t2.line, "'maybe nothing' says no more than 'nothing' itself — a value that may be nothing or nothing is just nothing. Write 'nothing' alone, or 'maybe' before a real kind, like: maybe number.")
            }
        }
        if t2.kind != "name" {
            give errAt(t2.line, "After 'maybe' I need a kind — one of: number, text, boolean, list, object, bytes. Instead I found " + pSpoken(t2) + ".")
        }
        let inner = t2.name
        if isKindWord(inner) == false {
            give errAt(t2.line, "I don't know a kind called '" + inner + "'. The kinds a value can be marked as are: number, text, boolean, list, object, bytes, nothing — and 'maybe' can stand before any of them but 'nothing', like: maybe number.")
        }
        pAdvance()
        give okVal("maybe " + inner)
    }
    if isKindWord(word) == false {
        give errAt(t.line, "I don't know a kind called '" + word + "'. The kinds a value can be marked as are: number, text, boolean, list, object, bytes, nothing.")
    }
    pAdvance()
    give okVal(word)
}

make parseStatement() {
    let token = pCur()

    // A floor block standing on its own.
    if token.kind == "floor" {
        pAdvance()
        give okVal({ type: "doExpr", expr: { type: "floor", asm: token.asm, args: [], line: token.line }, line: token.line })
    }

    // A floor block handed values, standing on its own:
    // floor(values) { ... } — the same expression, run for
    // what it does to the memory it was handed.
    if pIsKw("floor") {
        let f = parseFloorExpr()
        if f.ok == false {
            give f
        }
        give okVal({ type: "doExpr", expr: f.value, line: token.line })
    }

    if pIsKw("let") {
        pAdvance()
        if pCur().kind != "name" {
            give errAt(pCur().line, "After 'let' I need a name for the new variable, like: let years = 29. Instead I found " + pSpoken(pCur()) + ".")
        }
        let name = pCur().name
        pAdvance()
        let kindWord = ""
        if pIsSym(":") {
            pAdvance()
            let k = parseKindWord("':' after 'let " + name + "'")
            if k.ok == false {
                give k
            }
            kindWord = k.value
        }
        if pIsSym("=") == false {
            give errAt(pCur().line, "After 'let " + name + "' I need an '=' and then a value, like: let " + name + " = 29. Instead I found " + pSpoken(pCur()) + ".")
        }
        pAdvance()
        let v = parseExpression()
        if v.ok == false {
            give v
        }
        give okVal({ type: "declare", name: name, kindWord: kindWord, value: v.value, line: token.line })
    }

    if pIsKw("say") {
        pAdvance()
        let v = parseExpression()
        if v.ok == false {
            give v
        }
        give okVal({ type: "say", value: v.value, line: token.line })
    }

    if pIsKw("if") {
        pAdvance()
        let cond = parseExpression()
        if cond.ok == false {
            give cond
        }
        if pIsSym("{") == false {
            if pIsSym("=") {
                give errAt(pCur().line, "After the 'if' condition I expected '{' but found '='. To compare two things, use '==' — two equals signs. A single '=' sets a variable.")
            }
            give errAt(pCur().line, "After the 'if' condition I need a '{' to start the block that runs when it's true. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let thenR = parseBlock(openLine)
        if thenR.ok == false {
            give thenR
        }
        let elseStmts = []
        let hasElse = false
        if pIsKw("else") {
            pAdvance()
            if pIsSym("{") == false {
                give errAt(pCur().line, "After 'else' I need a '{' to start the block that runs when the condition is false. Instead I found " + pSpoken(pCur()) + ".")
            }
            let elseOpen = pCur().line
            pAdvance()
            let elseR = parseBlock(elseOpen)
            if elseR.ok == false {
                give elseR
            }
            elseStmts = elseR.value
            hasElse = true
        }
        give okVal({ type: "if", condition: cond.value, thenStmts: thenR.value, elseStmts: elseStmts, hasElse: hasElse, line: token.line })
    }

    if pIsKw("while") {
        pAdvance()
        let cond = parseExpression()
        if cond.ok == false {
            give cond
        }
        if pIsSym("{") == false {
            if pIsSym("=") {
                give errAt(pCur().line, "After the 'while' condition I expected '{' but found '='. To compare two things, use '==' — two equals signs. A single '=' sets a variable.")
            }
            give errAt(pCur().line, "After the 'while' condition I need a '{' to start the block that runs again and again while it's true. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let bodyR = parseBlock(openLine)
        if bodyR.ok == false {
            give bodyR
        }
        give okVal({ type: "while", condition: cond.value, body: bodyR.value, line: token.line })
    }

    if pIsKw("repeat") {
        pAdvance()
        let count = parseExpression()
        if count.ok == false {
            give count
        }
        if pIsSym("{") == false {
            give errAt(pCur().line, "After the 'repeat' count I need a '{' to start the block that runs that many times, like: repeat 3 { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let bodyR = parseBlock(openLine)
        if bodyR.ok == false {
            give bodyR
        }
        give okVal({ type: "repeat", count: count.value, body: bodyR.value, line: token.line })
    }

    if pIsKw("for") {
        pAdvance()
        if pCur().kind != "name" {
            give errAt(pCur().line, "After 'for' I need a name for each item the loop walks through, like: for item in items { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        let name = pCur().name
        pAdvance()
        if pIsKw("in") == false {
            give errAt(pCur().line, "After 'for " + name + "' I need 'in' and then the list or text to walk through, like: for " + name + " in items { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        pAdvance()
        let over = parseExpression()
        if over.ok == false {
            give over
        }
        if pIsSym("{") == false {
            give errAt(pCur().line, "After 'for " + name + " in ...' I need a '{' to start the block that runs for each item. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let bodyR = parseBlock(openLine)
        if bodyR.ok == false {
            give bodyR
        }
        give okVal({ type: "for", name: name, over: over.value, body: bodyR.value, line: token.line })
    }

    if pIsKw("make") {
        pAdvance()
        if pCur().kind != "name" {
            give errAt(pCur().line, "After 'make' I need a name for the new function, like: make greet(name) { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        let name = pCur().name
        pAdvance()
        if pIsSym("(") == false {
            give errAt(pCur().line, "After the function's name I need '(' and the names of the values it takes, like: make " + name + "(name) { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        pAdvance()  // the '('
        let params = []
        let paramKinds = []
        if pIsSym(")") == false {
            let collecting = true
            while collecting {
                if pCur().kind != "name" {
                    give errAt(pCur().line, "Inside the parentheses of 'make " + name + "' I need names for the values, separated by commas, like: make " + name + "(a, b) { ... }. Instead I found " + pSpoken(pCur()) + ".")
                }
                let param = pCur().name
                if nameIndex(params, param) >= 0 {
                    give errAt(pCur().line, "The function '" + name + "' uses the name '" + param + "' twice in its list of values. Each value needs its own name.")
                }
                append(params, param)
                pAdvance()
                let pkind = ""
                if pIsSym(":") {
                    pAdvance()
                    let k = parseKindWord("':' after '" + param + "'")
                    if k.ok == false {
                        give k
                    }
                    pkind = k.value
                }
                append(paramKinds, pkind)
                if pIsSym(",") {
                    pAdvance()
                } else {
                    collecting = false
                }
            }
        }
        if pIsSym(")") == false {
            give errAt(pCur().line, "I expected a ')' to close the list of values for '" + name + "', but I found " + pSpoken(pCur()) + ".")
        }
        pAdvance()  // the ')'
        let returnKind = ""
        if pIsSym("->") {
            pAdvance()
            let k = parseKindWord("'->' in 'make " + name + "'")
            if k.ok == false {
                give k
            }
            returnKind = k.value
        }
        if pIsSym("{") == false {
            give errAt(pCur().line, "After 'make " + name + "(...)' I need a '{' to start the block that runs when the function is called. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let bodyR = parseBlock(openLine)
        if bodyR.ok == false {
            give bodyR
        }
        give okVal({ type: "define", name: name, params: params, paramKinds: paramKinds, returnKind: returnKind, body: bodyR.value, line: token.line })
    }

    if pIsKw("give") {
        pAdvance()
        let v = parseExpression()
        if v.ok == false {
            give v
        }
        give okVal({ type: "give", value: v.value, line: token.line })
    }

    if pIsKw("attempt") {
        pAdvance()
        if pIsSym("{") == false {
            give errAt(pCur().line, "After 'attempt' I need a '{' to start the block that tries something, like: attempt { ... } if it fails { ... }. Instead I found " + pSpoken(pCur()) + ".")
        }
        let openLine = pCur().line
        pAdvance()
        let bodyR = parseBlock(openLine)
        if bodyR.ok == false {
            give bodyR
        }
        let follows = false
        if pIsKw("if") {
            let second = pNext()
            if second.kind == "name" {
                if second.name == "it" {
                    follows = true
                }
            }
        }
        if follows == false {
            give errAt(pCur().line, "After an 'attempt' block I need 'if it fails' and a block saying what to do when something goes wrong, like: attempt { ... } if it fails { ... }.")
        }
        pAdvance()  // 'if'
        pAdvance()  // 'it'
        if pCur().kind != "name" {
            give errAt(pCur().line, "After an 'attempt' block I need 'if it fails' and a block saying what to do when something goes wrong, like: attempt { ... } if it fails { ... }.")
        }
        if pCur().name != "fails" {
            give errAt(pCur().line, "After an 'attempt' block I need 'if it fails' and a block saying what to do when something goes wrong, like: attempt { ... } if it fails { ... }.")
        }
        pAdvance()  // 'fails'
        if pIsSym("{") == false {
            give errAt(pCur().line, "After 'if it fails' I need a '{' to start the block that runs when something goes wrong. Instead I found " + pSpoken(pCur()) + ".")
        }
        let recoveryOpen = pCur().line
        pAdvance()
        let recoveryR = parseBlock(recoveryOpen)
        if recoveryR.ok == false {
            give recoveryR
        }
        give okVal({ type: "attempt", body: bodyR.value, recovery: recoveryR.value, line: token.line })
    }

    // Lines that start with a name: setting a variable, setting a
    // field or an item, or calling a function for what it does.
    if token.kind == "name" {
        let name = token.name
        let next = pNext()
        if next.kind == "symbol" {
            if next.symbol == "=" {
                pAdvance()  // the name
                pAdvance()  // the '='
                let v = parseExpression()
                if v.ok == false {
                    give v
                }
                give okVal({ type: "assign", name: name, value: v.value, line: token.line })
            }
            if next.symbol == "(" {
                pAdvance()  // the name
                let argsR = parseCallArgs(name)
                if argsR.ok == false {
                    give argsR
                }
                give okVal({ type: "doCall", name: name, args: argsR.value, line: token.line })
            }
            if next.symbol == "." {
                let targetR = parseTargetChain(name, token.line)
                if targetR.ok == false {
                    give targetR
                }
                let v = parseExpression()
                if v.ok == false {
                    give v
                }
                give okVal({ type: "assignTarget", target: targetR.value, value: v.value, line: token.line })
            }
            if next.symbol == "[" {
                let targetR = parseTargetChain(name, token.line)
                if targetR.ok == false {
                    give targetR
                }
                let v = parseExpression()
                if v.ok == false {
                    give v
                }
                give okVal({ type: "assignTarget", target: targetR.value, value: v.value, line: token.line })
            }
        }
        give errAt(token.line, "I found the name '" + name + "' at the start of a line, but a line needs to do something: make a variable with 'let " + name + " = ...', set it with '" + name + " = ...', set a field with '" + name + ".field = ...', set an item with '" + name + "[0] = ...', show it with 'say " + name + "', or call a function with '" + name + "(...)'.")
    }

    give errAt(token.line, "I expected a line to start with 'let', 'say', 'if', 'attempt', 'while', 'repeat', 'for', 'make', 'give', or the name of a variable to set — but I found " + pSpoken(token) + ".")
}

// A floor expression: the 'floor' keyword, the values handed
// to the block in parentheses when there are any, and the
// block itself (which the lexer captured whole, as one token).
make parseFloorExpr() {
    let token = pCur()
    pAdvance()  // the 'floor' keyword
    let args = []
    if pIsSym("(") {
        let argsR = parseCallArgs("floor")
        if argsR.ok == false {
            give argsR
        }
        args = argsR.value
    }
    if pCur().kind != "floor" {
        give errAt(pCur().line, "After 'floor' I need the block itself: '{' on the same line, then the processor instructions on the lines below, until a line holding only '}'.")
    }
    let block = pCur()
    pAdvance()
    give okVal({ type: "floor", asm: block.asm, args: args, line: token.line })
}

// A target chain after a leading name — ".field" and "[...]"
// steps — ending at the '=' of a setting line. The current token
// is the name; the chain and the '=' are consumed here, so the
// caller parses the value next.
make parseTargetChain(name, line) {
    pAdvance()  // the name
    let target = { type: "variable", name: name, line: line }
    let going = true
    while going {
        if pIsSym(".") {
            let dotTok = pCur()
            pAdvance()  // the '.'
            if pCur().kind != "name" {
                give errAt(pCur().line, "After '.' I need the name of a field, like: " + name + ".years. Instead I found " + pSpoken(pCur()) + ".")
            }
            let fieldName = pCur().name
            pAdvance()
            target = { type: "field", base: target, name: fieldName, line: dotTok.line }
        } else {
            if pIsSym("[") {
                let bracketTok = pCur()
                pAdvance()  // the '['
                let idx = parseExpression()
                if idx.ok == false {
                    give idx
                }
                if pIsSym("]") == false {
                    give errAt(pCur().line, "I expected a ']' to close the '[' from line " + bracketTok.line + ", but I found " + pSpoken(pCur()) + ".")
                }
                pAdvance()  // the ']'
                target = { type: "index", base: target, index: idx.value, line: bracketTok.line }
            } else {
                going = false
            }
        }
    }
    if pIsSym("=") == false {
        give errAt(pCur().line, "A line that starts with a field or an item like this needs to set it: write an '=' and the new value, like: " + name + ".years = 30 or " + name + "[0] = 30. To show it instead, write it after 'say'.")
    }
    pAdvance()  // the '='
    give okVal(target)
}

// The "( value, value )" part of a call. The current token is
// the '('.
make parseCallArgs(name) {
    pAdvance()  // the '('
    let args = []
    if pIsSym(")") == false {
        let collecting = true
        while collecting {
            let a = parseExpression()
            if a.ok == false {
                give a
            }
            append(args, a.value)
            if pIsSym(",") {
                pAdvance()
            } else {
                collecting = false
            }
        }
    }
    if pIsSym(")") == false {
        give errAt(pCur().line, "I expected a ')' to close the '(' in this call to '" + name + "', but I found " + pSpoken(pCur()) + ".")
    }
    pAdvance()  // the ')'
    give okVal(args)
}

// ---------- expression parsing ----------

make parseExpression() {
    give parseEquality()
}

// One level of the precedence climb: parse a tighter level, then
// fold in any of this level's signs, left to right.
make parseBinaryLevel(tighter, ops) {
    let leftR = giveTighter(tighter)
    if leftR.ok == false {
        give leftR
    }
    let left = leftR.value
    let going = true
    while going {
        let t = pCur()
        if t.kind == "symbol" {
            if nameIndex(ops, t.symbol) >= 0 {
                pAdvance()
                let rightR = giveTighter(tighter)
                if rightR.ok == false {
                    give rightR
                }
                left = { type: "binary", op: t.symbol, left: left, right: rightR.value, line: t.line }
            } else {
                going = false
            }
        } else {
            going = false
        }
    }
    give okVal(left)
}

// Names the tighter level for parseBinaryLevel, so the four
// levels can share one body of code.
make giveTighter(which) {
    if which == "comparison" {
        give parseComparison()
    }
    if which == "sum" {
        give parseSum()
    }
    if which == "term" {
        give parseTerm()
    }
    give parseFactor()
}

make parseEquality() {
    give parseBinaryLevel("comparison", ["==", "!="])
}

make parseComparison() {
    give parseBinaryLevel("sum", ["<", "<=", ">", ">="])
}

make parseSum() {
    give parseBinaryLevel("term", ["+", "-"])
}

make parseTerm() {
    give parseBinaryLevel("factor", ["*", "/"])
}

make parseFactor() {
    if pIsSym("-") {
        let opTok = pCur()
        pAdvance()
        let inner = parseFactor()
        if inner.ok == false {
            give inner
        }
        give okVal({ type: "negate", inner: inner.value, line: opTok.line })
    }
    give parsePostfix()
}

// An atom followed by any number of steps: '.field' reads one
// field of an object, and '[...]' reads one item of a list or
// one character of some text.
make parsePostfix() {
    let exprR = parseAtom()
    if exprR.ok == false {
        give exprR
    }
    let expr = exprR.value
    let going = true
    while going {
        if pIsSym(".") {
            let dotTok = pCur()
            pAdvance()  // the '.'
            if pCur().kind != "name" {
                give errAt(pCur().line, "After '.' I need the name of a field, like: person.name. Instead I found " + pSpoken(pCur()) + ".")
            }
            let fieldName = pCur().name
            pAdvance()
            expr = { type: "field", base: expr, name: fieldName, line: dotTok.line }
        } else {
            if pIsSym("[") {
                let bracketTok = pCur()
                pAdvance()  // the '['
                let idx = parseExpression()
                if idx.ok == false {
                    give idx
                }
                if pIsSym("]") == false {
                    give errAt(pCur().line, "I expected a ']' to close the '[' from line " + bracketTok.line + ", but I found " + pSpoken(pCur()) + ".")
                }
                pAdvance()  // the ']'
                expr = { type: "index", base: expr, index: idx.value, line: bracketTok.line }
            } else {
                going = false
            }
        }
    }
    give okVal(expr)
}

make parseAtom() {
    let token = pCur()
    if token.kind == "number" {
        pAdvance()
        give okVal({ type: "number", value: token.num, line: token.line })
    }
    if token.kind == "text" {
        pAdvance()
        give okVal({ type: "text", value: token.text, line: token.line })
    }
    if token.kind == "keyword" {
        if token.word == "true" {
            pAdvance()
            give okVal({ type: "boolean", flag: true, line: token.line })
        }
        if token.word == "false" {
            pAdvance()
            give okVal({ type: "boolean", flag: false, line: token.line })
        }
        if token.word == "nothing" {
            pAdvance()
            give okVal({ type: "nothing", line: token.line })
        }
        if token.word == "floor" {
            give parseFloorExpr()
        }
    }
    if token.kind == "name" {
        pAdvance()
        if pIsSym("(") {
            let argsR = parseCallArgs(token.name)
            if argsR.ok == false {
                give argsR
            }
            give okVal({ type: "call", name: token.name, args: argsR.value, line: token.line })
        }
        give okVal({ type: "variable", name: token.name, line: token.line })
    }
    if token.kind == "symbol" {
        if token.symbol == "(" {
            pAdvance()
            let inner = parseExpression()
            if inner.ok == false {
                give inner
            }
            if pIsSym(")") == false {
                give errAt(pCur().line, "I expected a ')' to close the '(' from line " + token.line + ", but I found " + pSpoken(pCur()) + ".")
            }
            pAdvance()
            give okVal(inner.value)
        }
        if token.symbol == "{" {
            give parseObjectLiteral(token)
        }
        if token.symbol == "[" {
            give parseListLiteral(token)
        }
    }
    if token.kind == "floor" {
        pAdvance()
        give okVal({ type: "floor", asm: token.asm, args: [], line: token.line })
    }
    give errAt(token.line, "I expected a number, a piece of text, true, false, a variable name, an object like { name: \"Tyler\" }, a list like [1, 2, 3], or a floor block here, but I found " + pSpoken(token) + ".")
}

// A list literal: '[' then values separated by commas, then ']'.
make parseListLiteral(openToken) {
    pAdvance()  // the '['
    let items = []
    if pIsSym("]") == false {
        let collecting = true
        while collecting {
            let item = parseExpression()
            if item.ok == false {
                give item
            }
            append(items, item.value)
            if pIsSym(",") {
                pAdvance()
            } else {
                collecting = false
            }
        }
    }
    if pIsSym("]") == false {
        give errAt(pCur().line, "I expected a ']' to close the list that started on line " + openToken.line + ", but I found " + pSpoken(pCur()) + ".")
    }
    pAdvance()  // the ']'
    give okVal({ type: "list", items: items, line: openToken.line })
}

// An object literal: '{' then name ':' value pairs separated by
// commas, then '}'. A field named twice is refused here.
make parseObjectLiteral(openToken) {
    pAdvance()  // the '{'
    let names = []
    let values = []
    if pIsSym("}") == false {
        let collecting = true
        while collecting {
            if pCur().kind != "name" {
                give errAt(pCur().line, "Inside an object I need field names with values, like: { name: \"Tyler\", years: 29 }. Instead I found " + pSpoken(pCur()) + ".")
            }
            let fieldName = pCur().name
            let fieldLine = pCur().line
            pAdvance()
            if pIsSym(":") == false {
                give errAt(pCur().line, "After the field name '" + fieldName + "' I need a ':' and then its value, like: { " + fieldName + ": 29 }. Instead I found " + pSpoken(pCur()) + ".")
            }
            pAdvance()  // the ':'
            if nameIndex(names, fieldName) >= 0 {
                give errAt(fieldLine, "This object names the field '" + fieldName + "' twice. Each field needs its own name — take one of the two out.")
            }
            let v = parseExpression()
            if v.ok == false {
                give v
            }
            append(names, fieldName)
            append(values, v.value)
            if pIsSym(",") {
                pAdvance()
            } else {
                collecting = false
            }
        }
    }
    if pIsSym("}") == false {
        give errAt(pCur().line, "I expected a '}' to close the object that started on line " + openToken.line + ", but I found " + pSpoken(pCur()) + ".")
    }
    pAdvance()  // the '}'
    give okVal({ type: "object", names: names, values: values, line: openToken.line })
}

// ---------- the interpreter ----------
// Runs the tree the parser built. The run's state lives in these
// globals, the way the Swift interpreter keeps them in itself.

let gFnNames = []
let gFnDefs = []
let gLoopPasses = 0
let gCallDepth = 0
let gArgs = []

make okDone() {
    give { ok: true, gave: false, value: NOTHING }
}

// The runaway guard: a kindness limit on the total number of
// loop passes in one run, across every loop in the program.
make tickLoop(line) {
    gLoopPasses = gLoopPasses + 1
    if gLoopPasses > 1000000 {
        give errAt(line, "This loop ran more than a million times and was stopped — it may never end. Check the condition, and make sure something inside the loop changes each time around, so it can finish.")
    }
    give okVal(NOTHING)
}

// ---------- the machine (Stone 14) ----------
// The interpreter used to run a program by calling itself:
// a block ran its statements by calling the statement worker,
// which worked values out by calling the value worker, which
// called the function caller, which ran a block again — one
// host call inside another, as deep as the program's own calls
// went. Two of the thirty-six example programs showed what
// that costs: a program that calls itself five hundred times
// (the depth the language itself allows) needed some six host
// calls for every one of its own, so the host's own depth
// guard — and, compiled, the native stack — gave out around
// depth eighty, long before the program's own guard could
// speak; and an endless loop's passes each cost a host loop
// pass of the worker's own loops, on top of what starting up
// had already spent, so the host's million-pass guard spoke
// first there too, naming a line inside this interpreter
// instead of the program's own line.
//
// So the run is a machine now. The work in flight is a stack
// of frames held in a plain list — heap, not call stack — and
// a driver takes one small step at a time: start a frame,
// hand a finished value to the frame waiting under it, or
// unwind. A program's own calls push frames; they no longer
// push the host's stack, so the depth a program can reach is
// bounded by its own five-hundred guard and by memory, the
// way the Swift interpreter bounds it. And the driver takes
// up to thirty-two steps per pass of its own loop, so the
// host's million-pass guard measures the machine's work in
// coarse units: a program's loop passes are counted by
// tickLoop in the program's own units, exactly as before, and
// for a runaway program its own guard — with its own line —
// is the one that speaks. No guard's number changed, and no
// count is kept in anything but the program's own units.
//
// A frame is an object with a 'kind'. The result of the last
// finished piece of work travels in mResult; mGave says
// whether it is a 'give' on its way out of a function (a plain
// value result carries no 'gave' field, so the flag travels
// beside it rather than being read off the result). Two
// small honest frugalities keep the machine quick enough to
// be useful: a value that needs no gathering — a number, a
// piece of text, a true/false, a variable's contents — is
// handed over at once instead of taking a frame round-trip,
// and a block with no statements in it is finished the
// moment it is laid down, since an empty block's outcome is
// always the same. Neither changes what anything means; both
// only skip journeys that would have arrived at the same
// place. mDone is the one shared 'finished, nothing to hand
// back' result — results are never changed once made, so a
// single one serves everywhere it is needed.

let mStack = []
let mResult = okDone()
let mHasResult = false
let mGave = false
// Stone 18: the line of the 'give' whose value is travelling
// — the return guard at the call boundary speaks of it.
let mGiveLine = 0
let mDone = { ok: true, gave: false, value: NOTHING }
let mNotLeaf = { leaf: false }

// Puts a finished result in the travelling place, for the
// frame underneath to pick up.
make holdResult(result, gave) {
    mResult = result
    mGave = gave
    mHasResult = true
}

// Finishes the frame on top of the stack with a result.
make finishFrame(result, gave) {
    removeat(mStack, length(mStack) - 1)
    holdResult(result, gave)
}

// Lays a block of statements on the machine in a scope — or,
// if there is nothing in it, hands its outcome over at once.
make pushBlock(stmts, scope) {
    if length(stmts) == 0 {
        holdResult(mDone, false)
        give mDone
    }
    mHasResult = false
    append(mStack, { kind: "block", stmts: stmts, next: 0, scope: scope })
    give mDone
}

// Works out a value that needs no gathering, if this is one:
// gives back its result, or mNotLeaf when the value has
// pieces that must be gathered a frame at a time.
make evalLeaf(e, scope) {
    if e.type == "number" {
        give okVal(vNumber(e.value))
    }
    if e.type == "text" {
        give okVal(vText(e.value))
    }
    if e.type == "boolean" {
        give okVal(vBool(e.flag))
    }
    if e.type == "nothing" {
        give okVal(NOTHING)
    }
    if e.type == "variable" {
        let r = scopeLookup(scope, e.name)
        if r.found == false {
            let message = "I don't know a variable called '" + e.name + "' yet. You can make one with: let " + e.name + " = ..."
            let close = closestOf(e.name, scopeAllNames(scope))
            if close.found {
                message = message + " Did you mean '" + close.name + "'?"
            }
            give errAt(e.line, message)
        }
        give okVal(r.value)
    }
    if e.type == "floor" {
        give errAt(e.line, "This is floor code — raw instructions for the processor — and the interpreter can't run it. Floor code runs only in a compiled program: build this program with niflac and run the program it makes.")
    }
    give mNotLeaf
}

// Sets a value's work going for the frame on top: handed over
// at once when it needs no gathering, otherwise an 'expr'
// frame is laid down for it.
make pushExpr(e, scope) {
    let r = evalLeaf(e, scope)
    if r == mNotLeaf {
        mHasResult = false
        append(mStack, { kind: "expr", e: e, scope: scope })
        give mDone
    }
    holdResult(r, false)
    give mDone
}

// Runs a whole program: one block frame on the machine, then
// steps until the stack is empty. Gives back the run's
// outcome — an error result, or the done result.
make runProgram(stmts) {
    mStack = []
    mHasResult = false
    mGave = false
    mResult = mDone
    append(mStack, { kind: "block", stmts: stmts, next: 0, scope: makeScope(NOTHING) })
    while length(mStack) > 0 {
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
        stepTop()
    }
    give mResult
}

// Takes one step of whatever sits on top of the stack: hand
// the waiting result to its frame, unwind a travelling error
// or 'give', or start a frame that is waiting to begin. The
// checks run hottest-first — blocks, calls, and values are
// the frames a run spends its life among.
make stepTop() {
    if length(mStack) == 0 {
        give mDone
    }
    let top = mStack[length(mStack) - 1]
    if mHasResult {
        if mResult.ok == false {
            stepUnwind(top)
            give mDone
        }
        if mGave {
            stepUnwind(top)
            give mDone
        }
        if top.kind == "block" {
            mHasResult = false
            give mDone
        }
        if top.kind == "whileStmt" {
            consumeWhile(top)
            give mDone
        }
        if top.kind == "repeatStmt" {
            consumeRepeat(top)
            give mDone
        }
        if top.kind == "forStmt" {
            consumeFor(top)
            give mDone
        }
        if top.kind == "call" {
            consumeCall(top)
            give mDone
        }
        if top.kind == "binary" {
            consumeBinary(top)
            give mDone
        }
        if top.kind == "getIndex" {
            consumeGetIndex(top)
            give mDone
        }
        if top.kind == "getField" {
            consumeGetField(top)
            give mDone
        }
        if top.kind == "negate" {
            consumeNegate(top)
            give mDone
        }
        if top.kind == "ifStmt" {
            consumeIf(top)
            give mDone
        }
        if top.kind == "declare" {
            if top.stmt.kindWord != "" {
                if kindSatisfies(top.stmt.kindWord, mResult.value) == false {
                    finishFrame(errAt(top.stmt.line, "'" + top.stmt.name + "' is marked as " + kindPhrase(top.stmt.kindWord) + " by its annotation, but this value is " + described(mResult.value) + ". Change the value, or change the annotation."), false)
                    give mDone
                }
            }
            scopeDeclare(top.scope, top.stmt.name, mResult.value)
            if top.stmt.kindWord != "" {
                scopeDeclareAnnotation(top.scope, top.stmt.name, top.stmt.kindWord)
            }
            finishFrame(mDone, false)
            give mDone
        }
        if top.kind == "assign" {
            let aw = scopeAnnotation(top.scope, top.stmt.name)
            if aw != "" {
                if kindSatisfies(aw, mResult.value) == false {
                    finishFrame(errAt(top.stmt.line, "'" + top.stmt.name + "' is marked as " + kindPhrase(aw) + " by its annotation, but this value is " + described(mResult.value) + ". Change the value, or change the annotation."), false)
                    give mDone
                }
            }
            if scopeAssign(top.scope, top.stmt.name, mResult.value) == false {
                finishFrame(errAt(top.stmt.line, "I can't set '" + top.stmt.name + "', because no variable called '" + top.stmt.name + "' has been made yet. Make one first with: let " + top.stmt.name + " = ..."), false)
                give mDone
            }
            finishFrame(mDone, false)
            give mDone
        }
        if top.kind == "sayStmt" {
            say spokenOf(mResult.value)
            finishFrame(mDone, false)
            give mDone
        }
        if top.kind == "doExpr" {
            finishFrame(mDone, false)
            give mDone
        }
        if top.kind == "giveStmt" {
            mGiveLine = top.stmt.line
            finishFrame({ ok: true, gave: true, value: mResult.value }, true)
            give mDone
        }
        if top.kind == "attempt" {
            finishFrame(mDone, false)
            give mDone
        }
        if top.kind == "setTarget" {
            consumeSetTarget(top)
            give mDone
        }
        if top.kind == "objlit" {
            consumeObjlit(top)
            give mDone
        }
        if top.kind == "listlit" {
            consumeListlit(top)
            give mDone
        }
        give mDone
    }
    if top.kind == "block" {
        stepBlockStart(top)
        give mDone
    }
    if top.kind == "expr" {
        stepExprStart(top)
        give mDone
    }
    if top.kind == "call" {
        stepCallStart(top)
        give mDone
    }
    give mDone
}

// A result is travelling up: an error looking for an 'attempt'
// that will catch it, or a 'give' looking for the function it
// leaves. Frames it passes are simply lifted off — except an
// attempt that hasn't caught yet, which catches an error, and
// a call frame whose function body just finished, which is
// the boundary a 'give' steps across (and where the depth
// count steps back down, on every road out).
make stepUnwind(top) {
    if top.kind == "attempt" {
        if mResult.ok == false {
            if top.caught == false {
                top.caught = true
                let recoveryScope = makeScope(top.scope)
                scopeDeclare(recoveryScope, "problem", vText(mResult.bare))
                pushBlock(top.stmt.recovery, recoveryScope)
                give mDone
            }
        }
    }
    if top.kind == "call" {
        if top.stage == 2 {
            gCallDepth = gCallDepth - 1
            if mGave {
                let value = mResult.value
                if top.def.returnKind != "" {
                    if kindSatisfies(top.def.returnKind, value) == false {
                        removeat(mStack, length(mStack) - 1)
                        mGave = false
                        holdResult(errAt(mGiveLine, "'" + top.name + "' is marked to give back " + kindPhrase(top.def.returnKind) + " by its annotation, but this 'give' hands back " + described(value) + ". Change the value, or change the annotation."), false)
                        give mDone
                    }
                }
                removeat(mStack, length(mStack) - 1)
                mGave = false
                // Stone 19: a function marked '-> nothing'
                // never hands a value back — a 'give nothing'
                // line inside it is an early way out, and the
                // empty value it names is absorbed by the
                // promise. Any other function's given value
                // crosses as it is — the empty value included.
                if top.inExpr {
                    if top.def.returnKind == "nothing" {
                        holdResult(errAt(top.line, "The function '" + top.name + "' finished without giving a value back, so there is nothing to use here. Add a 'give' line inside '" + top.name + "', or call it on its own line instead."), false)
                        give mDone
                    }
                }
                holdResult(okVal(value), false)
                give mDone
            }
        }
    }
    removeat(mStack, length(mStack) - 1)
    give mDone
}

// A block frame's start: take the next statement and set its
// work going. Statements that need no values worked out are
// settled on the spot; the rest push a frame of their own,
// with the first value they need set going above it.
make stepBlockStart(top) {
    if top.next >= length(top.stmts) {
        finishFrame(mDone, false)
        give mDone
    }
    let s = top.stmts[top.next]
    top.next = top.next + 1
    dispatchStmt(top, s)
    give mDone
}

make dispatchStmt(blockFrame, s) {
    if s.type == "declare" {
        if scopeDeclaredHere(blockFrame.scope, s.name) {
            holdResult(errAt(s.line, "There is already a variable called '" + s.name + "' in this block. To change what it holds, write: " + s.name + " = ..."), false)
            give mDone
        }
        append(mStack, { kind: "declare", stmt: s, scope: blockFrame.scope })
        pushExpr(s.value, blockFrame.scope)
        give mDone
    }
    if s.type == "assign" {
        append(mStack, { kind: "assign", stmt: s, scope: blockFrame.scope })
        pushExpr(s.value, blockFrame.scope)
        give mDone
    }
    if s.type == "assignTarget" {
        append(mStack, { kind: "setTarget", stmt: s, scope: blockFrame.scope, stage: 0, base: NOTHING, idx: 0 })
        pushExpr(s.target.base, blockFrame.scope)
        give mDone
    }
    if s.type == "say" {
        append(mStack, { kind: "sayStmt", stmt: s, scope: blockFrame.scope })
        pushExpr(s.value, blockFrame.scope)
        give mDone
    }
    if s.type == "if" {
        append(mStack, { kind: "ifStmt", stmt: s, scope: blockFrame.scope, stage: 0 })
        pushExpr(s.condition, blockFrame.scope)
        give mDone
    }
    if s.type == "while" {
        append(mStack, { kind: "whileStmt", stmt: s, scope: blockFrame.scope, stage: 0, bodyEmpty: length(s.body) == 0, condReady: false, condResult: NOTHING })
        pushExpr(s.condition, blockFrame.scope)
        give mDone
    }
    if s.type == "repeat" {
        append(mStack, { kind: "repeatStmt", stmt: s, scope: blockFrame.scope, stage: 0, n: 0, done: 0, bodyEmpty: length(s.body) == 0 })
        pushExpr(s.count, blockFrame.scope)
        give mDone
    }
    if s.type == "for" {
        append(mStack, { kind: "forStmt", stmt: s, scope: blockFrame.scope, stage: 0, items: [], index: 0 })
        pushExpr(s.over, blockFrame.scope)
        give mDone
    }
    if s.type == "define" {
        if isBuiltinName(s.name) {
            holdResult(errAt(s.line, "There is already a built-in tool called '" + s.name + "' — every Nifla program has it from the start. A function can't be made with that name; rename the function."), false)
            give mDone
        }
        if nameIndex(gFnNames, s.name) >= 0 {
            holdResult(errAt(s.line, "There is already a function called '" + s.name + "'. Each function needs its own name — rename this one, or take out the earlier 'make " + s.name + "'."), false)
            give mDone
        }
        append(gFnNames, s.name)
        append(gFnDefs, { params: s.params, paramKinds: s.paramKinds, returnKind: s.returnKind, body: s.body, home: blockFrame.scope })
        holdResult(mDone, false)
        give mDone
    }
    if s.type == "give" {
        if gCallDepth == 0 {
            holdResult(errAt(s.line, "'give' hands a value back from a function to whoever called it, but this line is not inside a function. To show a value here, use 'say' instead."), false)
            give mDone
        }
        append(mStack, { kind: "giveStmt", stmt: s, scope: blockFrame.scope })
        pushExpr(s.value, blockFrame.scope)
        give mDone
    }
    if s.type == "attempt" {
        append(mStack, { kind: "attempt", stmt: s, scope: blockFrame.scope, caught: false })
        pushBlock(s.body, makeScope(blockFrame.scope))
        give mDone
    }
    if s.type == "doCall" {
        let frame = { kind: "call", name: s.name, argExprs: s.args, line: s.line, scope: blockFrame.scope, inExpr: false, stage: 0, values: [], nextArg: 0, def: NOTHING }
        let begun = callBegin(frame)
        if begun.ok == false {
            holdResult(begun, false)
            give mDone
        }
        append(mStack, frame)
        give mDone
    }
    if s.type == "doExpr" {
        append(mStack, { kind: "doExpr", stmt: s, scope: blockFrame.scope })
        pushExpr(s.expr, blockFrame.scope)
        give mDone
    }
    holdResult(mDone, false)
    give mDone
}


// An 'if' frame: the condition's value is waiting. Decide,
// and run the chosen branch in a child scope; when its block
// finishes, the 'if' is finished too.
make consumeIf(top) {
    if top.stage == 0 {
        let v = mResult.value
        if v.kind != "boolean" {
            finishFrame(errAt(top.stmt.line, "'if' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: if years > 12 { ... }"), false)
            give mDone
        }
        let child = makeScope(top.scope)
        if v.flag {
            top.stage = 1
            pushBlock(top.stmt.thenStmts, child)
            give mDone
        }
        if top.stmt.hasElse {
            top.stage = 1
            pushBlock(top.stmt.elseStmts, child)
            give mDone
        }
        finishFrame(mDone, false)
        give mDone
    }
    finishFrame(mDone, false)
    give mDone
}

// A 'while' frame: stage 0 waits for the condition — the pass
// is counted (tickLoop) only once the condition says go, the
// same order the interpreter has always kept — and stage 1
// waits for the body's block, then starts the next pass. A
// body with no statements in it is a waiting loop, and takes
// the waiting road below instead.
make consumeWhile(top) {
    if top.stage == 0 {
        if top.bodyEmpty {
            waitLoop(top)
            give mDone
        }
        let v = mResult.value
        if v.kind != "boolean" {
            finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
            give mDone
        }
        if v.flag == false {
            finishFrame(mDone, false)
            give mDone
        }
        let t = tickLoop(top.stmt.line)
        if t.ok == false {
            finishFrame(t, false)
            give mDone
        }
        top.stage = 1
        pushBlock(top.stmt.body, makeScope(top.scope))
        give mDone
    }
    top.stage = 0
    pushExpr(top.stmt.condition, top.scope)
    give mDone
}

// ---------- waiting loops ----------
// A loop whose body holds no statements does no work per
// pass but wait: nothing in it can change a variable, call a
// function, or speak. Stepping such a loop one frame at a
// time would spend far more of the host's time than the
// passes themselves hold — the compiled host's every call is
// a journey through its runtime's desk — so a waiting loop
// runs its passes in a tight counting loop of its own, eight
// passes to a turn. The host's own loop guard counts turns,
// so it stays far behind; the program's guard counts passes,
// in the program's own units, exactly as everywhere else,
// and it is the one that speaks for a loop that never ends.
// The condition of a waiting 'while' is worked out once when
// it needs no gathering (a literal, or a variable — whose
// value an empty body cannot change) and kept in the frame;
// the moment anything needs the machine — a condition with
// pieces — the ordinary road takes over, in the same state
// the step-by-step road would have left.

make waitLoop(top) {
    let going = true
    while going {
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
        if going {
            let v = mResult.value
            if v.kind != "boolean" {
                finishFrame(errAt(top.stmt.line, "'while' needs a true or false value to decide with, but here it was given " + described(v) + ". Try a comparison, like: while years < 40 { ... }"), false)
                give mDone
            }
            if v.flag == false {
                finishFrame(mDone, false)
                give mDone
            }
            let t = tickLoop(top.stmt.line)
            if t.ok == false {
                finishFrame(t, false)
                give mDone
            }
            if top.condReady == false {
                let r = evalLeaf(top.stmt.condition, top.scope)
                if r == mNotLeaf {
                    pushExpr(top.stmt.condition, top.scope)
                    give mDone
                }
                if r.ok == false {
                    holdResult(r, false)
                    give mDone
                }
                top.condResult = r
                top.condReady = true
            }
            mResult = top.condResult
            mGave = false
            mHasResult = true
        }
    }
    give mDone
}

// A 'repeat' frame: stage 0 waits for the count and checks
// it; stage 1 waits for a pass's block. Either way the frame
// then falls into the same advance: count the pass, and set
// the next one going, or finish.
make consumeRepeat(top) {
    if top.stage == 0 {
        let v = mResult.value
        if v.kind != "number" {
            finishFrame(errAt(top.stmt.line, "'repeat' needs a number saying how many times to run, but here it was given " + described(v) + ". Write it like: repeat 3 { ... }"), false)
            give mDone
        }
        let n = v.num
        if n < 0 {
            finishFrame(errAt(top.stmt.line, "'repeat' was told to run " + numText(n) + " times, but a count can't be negative — a loop can't run less than zero times. Use zero or more, like: repeat 3 { ... }"), false)
            give mDone
        }
        if isWholeNum(n) == false {
            finishFrame(errAt(top.stmt.line, "'repeat' was told to run " + numText(n) + " times, but a loop can only run a whole number of times. Use a whole number instead, like " + numText(floorNum(n)) + " or " + numText(ceilNum(n)) + "."), false)
            give mDone
        }
        top.n = n
        top.done = 0
        top.stage = 1
        if top.bodyEmpty {
            repeatWait(top)
            give mDone
        }
    } else {
        top.done = top.done + 1
    }
    if top.done >= top.n {
        finishFrame(mDone, false)
        give mDone
    }
    let t = tickLoop(top.stmt.line)
    if t.ok == false {
        finishFrame(t, false)
        give mDone
    }
    pushBlock(top.stmt.body, makeScope(top.scope))
    give mDone
}

// A waiting 'repeat': the same counting loop as a waiting
// 'while' (see above), counting passes against the count the
// frame was given. The first pass is counted on entry; each
// pass after it is counted as the one before finishes.
make repeatWait(top) {
    if top.done >= top.n {
        finishFrame(mDone, false)
        give mDone
    }
    let t = tickLoop(top.stmt.line)
    if t.ok == false {
        finishFrame(t, false)
        give mDone
    }
    let going = true
    while going {
        going = repeatPass(top)
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
        if going {
            going = repeatPass(top)
        }
    }
    give mDone
}

make repeatPass(top) {
    top.done = top.done + 1
    if top.done >= top.n {
        finishFrame(mDone, false)
        give false
    }
    let t = tickLoop(top.stmt.line)
    if t.ok == false {
        finishFrame(t, false)
        give false
    }
    give true
}

// A 'for' frame: stage 0 waits for the value being walked and
// lays its items out in a list of their own (a copy, so adding
// to the walked list as we go can't change the walk); stage 1
// waits for a pass's block. Either way the frame then falls
// into the same advance: count the pass, and set the next one
// going, in a fresh child scope with the walked item declared
// in it, or finish.
make consumeFor(top) {
    if top.stage == 0 {
        let over = mResult.value
        let items = []
        if over.kind == "list" {
            items = copyList(over.items)
        } else {
            if over.kind == "text" {
                for ch in over.text {
                    append(items, vText(ch))
                }
            } else {
                if over.kind == "bytes" {
                    for b in over.data {
                        append(items, vNumber(b))
                    }
                } else {
                    finishFrame(errAt(top.stmt.line, "'for' needs a list, some text, or a block of bytes to walk through, but here it was given " + described(over) + ". Write it like: for item in items { ... }"), false)
                    give mDone
                }
            }
        }
        top.items = items
        top.index = 0
        top.stage = 1
    } else {
        top.index = top.index + 1
    }
    if top.index >= length(top.items) {
        finishFrame(mDone, false)
        give mDone
    }
    let t = tickLoop(top.stmt.line)
    if t.ok == false {
        finishFrame(t, false)
        give mDone
    }
    let child = makeScope(top.scope)
    scopeDeclare(child, top.stmt.name, top.items[top.index])
    pushBlock(top.stmt.body, child)
    give mDone
}

// Setting a field or an item: the stages walk the same road
// the interpreter always walked — the chain's base is read,
// the holder is checked, and only then is the new value
// worked out. Stage 0 waits for the base; stage 1 for the
// item number (or, for a field, the new value); stage 2 for
// the new value of an item.
make consumeSetTarget(top) {
    let target = top.stmt.target
    if top.stage == 0 {
        let base = mResult.value
        top.base = base
        if target.type == "field" {
            if base.kind != "object" {
                finishFrame(errAt(top.stmt.line, "I can't set the field '" + target.name + "' on " + described(base) + ", because only an object has fields. Make an object first, like: let person = { name: \"Tyler\" } — then person." + target.name + " = ... works."), false)
                give mDone
            }
            top.stage = 1
            pushExpr(top.stmt.value, top.scope)
            give mDone
        }
        if target.type == "index" {
            if base.kind == "text" {
                finishFrame(errAt(target.line, "I can't change one character of some text — once text is made, it doesn't change. To change it, build the new text and set the variable to it instead."), false)
                give mDone
            }
            if base.kind == "list" {
                top.stage = 1
                pushExpr(target.index, top.scope)
                give mDone
            }
            if base.kind == "bytes" {
                top.stage = 1
                pushExpr(target.index, top.scope)
                give mDone
            }
            finishFrame(errAt(target.line, "I can only set an item in a list, like: items[0] = 30 — but this is " + described(base) + ", which has no items to set."), false)
            give mDone
        }
        finishFrame(errAt(top.stmt.line, "I can only set a field on an object or an item in a list, like: person.years = 30 or items[0] = 30."), false)
        give mDone
    }
    if top.stage == 1 {
        if target.type == "field" {
            objSet(top.base, target.name, mResult.value)
            finishFrame(mDone, false)
            give mDone
        }
        let num = itemNumber(mResult.value, target.line)
        if num.ok == false {
            finishFrame(num, false)
            give mDone
        }
        let idx = num.value
        top.idx = idx
        if top.base.kind == "list" {
            if length(top.base.items) == 0 {
                finishFrame(errAt(target.line, "This list has no items yet, so there is no item " + idx + " to set. To add an item at the end, use append — like: append(items, ...)."), false)
                give mDone
            }
            if idx < 0 {
                finishFrame(errAt(target.line, "This list has " + length(top.base.items) + " items, numbered 0 to " + (length(top.base.items) - 1) + ", so there is no item " + idx + " to set. To add an item at the end, use append — like: append(items, ...)."), false)
                give mDone
            }
            if idx >= length(top.base.items) {
                finishFrame(errAt(target.line, "This list has " + length(top.base.items) + " items, numbered 0 to " + (length(top.base.items) - 1) + ", so there is no item " + idx + " to set. To add an item at the end, use append — like: append(items, ...)."), false)
                give mDone
            }
        } else {
            if length(top.base.data) == 0 {
                finishFrame(errAt(target.line, "This block of bytes has no bytes yet, so there is no byte " + idx + " to set. Make a bigger block with makebytes — like: makebytes(8)."), false)
                give mDone
            }
            if idx < 0 {
                finishFrame(errAt(target.line, "This block of bytes has " + length(top.base.data) + " bytes, numbered 0 to " + (length(top.base.data) - 1) + ", so there is no byte " + idx + " to set."), false)
                give mDone
            }
            if idx >= length(top.base.data) {
                finishFrame(errAt(target.line, "This block of bytes has " + length(top.base.data) + " bytes, numbered 0 to " + (length(top.base.data) - 1) + ", so there is no byte " + idx + " to set."), false)
                give mDone
            }
        }
        top.stage = 2
        pushExpr(top.stmt.value, top.scope)
        give mDone
    }
    let v = mResult.value
    if top.base.kind == "list" {
        top.base.items[top.idx] = v
        finishFrame(mDone, false)
        give mDone
    }
    if v.kind != "number" {
        finishFrame(errAt(target.line, "A byte is a whole number from 0 to 255, but I was given " + described(v) + "."), false)
        give mDone
    }
    if isWholeNum(v.num) == false {
        finishFrame(errAt(target.line, "A byte is a whole number from 0 to 255, but I was given " + described(v) + "."), false)
        give mDone
    }
    if v.num < 0 {
        finishFrame(errAt(target.line, "A byte is a whole number from 0 to 255, but I was given " + described(v) + "."), false)
        give mDone
    }
    if v.num > 255 {
        finishFrame(errAt(target.line, "A byte is a whole number from 0 to 255, but I was given " + described(v) + "."), false)
        give mDone
    }
    top.base.data[top.idx] = v.num
    finishFrame(mDone, false)
    give mDone
}

// ---------- values, worked out one piece at a time ----------
// An 'expr' frame looks at its node once: a node with pieces
// turns into the frame that gathers them, with the first
// piece set going above it. (A piece that needs no gathering
// never becomes a frame at all — pushExpr hands it over at
// once — so the leaf cases below are only a safety net.)
// Each gathering frame waits for one piece at a time, so no
// piece's work ever sits on the host's call stack.

make stepExprStart(top) {
    let e = top.e
    if e.type == "number" {
        finishFrame(okVal(vNumber(e.value)), false)
        give mDone
    }
    if e.type == "text" {
        finishFrame(okVal(vText(e.value)), false)
        give mDone
    }
    if e.type == "boolean" {
        finishFrame(okVal(vBool(e.flag)), false)
        give mDone
    }
    if e.type == "nothing" {
        finishFrame(okVal(NOTHING), false)
        give mDone
    }
    if e.type == "variable" {
        let r = scopeLookup(top.scope, e.name)
        if r.found == false {
            let message = "I don't know a variable called '" + e.name + "' yet. You can make one with: let " + e.name + " = ..."
            let close = closestOf(e.name, scopeAllNames(top.scope))
            if close.found {
                message = message + " Did you mean '" + close.name + "'?"
            }
            finishFrame(errAt(e.line, message), false)
            give mDone
        }
        finishFrame(okVal(r.value), false)
        give mDone
    }
    if e.type == "floor" {
        finishFrame(errAt(e.line, "This is floor code — raw instructions for the processor — and the interpreter can't run it. Floor code runs only in a compiled program: build this program with niflac and run the program it makes."), false)
        give mDone
    }
    if e.type == "negate" {
        top.kind = "negate"
        pushExpr(e.inner, top.scope)
        give mDone
    }
    if e.type == "binary" {
        top.kind = "binary"
        top.stage = 0
        top.saved = NOTHING
        pushExpr(e.left, top.scope)
        give mDone
    }
    if e.type == "field" {
        top.kind = "getField"
        pushExpr(e.base, top.scope)
        give mDone
    }
    if e.type == "index" {
        top.kind = "getIndex"
        top.stage = 0
        top.saved = NOTHING
        pushExpr(e.base, top.scope)
        give mDone
    }
    if e.type == "object" {
        top.kind = "objlit"
        top.i = 0
        top.obj = vObject()
        if length(e.names) == 0 {
            finishFrame(okVal(top.obj), false)
            give mDone
        }
        pushExpr(e.values[0], top.scope)
        give mDone
    }
    if e.type == "list" {
        top.kind = "listlit"
        top.i = 0
        top.items = []
        if length(e.items) == 0 {
            finishFrame(okVal(vList([])), false)
            give mDone
        }
        pushExpr(e.items[0], top.scope)
        give mDone
    }
    if e.type == "call" {
        top.kind = "call"
        top.name = e.name
        top.argExprs = e.args
        top.line = e.line
        top.inExpr = true
        top.stage = 0
        top.values = []
        top.nextArg = 0
        top.def = NOTHING
        let begun = callBegin(top)
        if begun.ok == false {
            finishFrame(begun, false)
            give mDone
        }
        give mDone
    }
    finishFrame(okVal(NOTHING), false)
    give mDone
}

make consumeBinary(top) {
    if top.stage == 0 {
        top.saved = mResult.value
        top.stage = 1
        pushExpr(top.e.right, top.scope)
        give mDone
    }
    finishFrame(applyOp(top.e.op, top.saved, mResult.value, top.e.line), false)
    give mDone
}

make consumeNegate(top) {
    let v = mResult.value
    if v.kind != "number" {
        finishFrame(errAt(top.e.line, "I can only put a minus sign in front of a number, but here it was in front of " + described(v) + "."), false)
        give mDone
    }
    finishFrame(okVal(vNumber(0 - v.num)), false)
    give mDone
}

make consumeGetField(top) {
    let b = mResult.value
    if b.kind != "object" {
        finishFrame(errAt(top.e.line, "I can't read the field '" + top.e.name + "' of " + described(b) + ", because only an object has fields. Make an object first, like: let person = { name: \"Tyler\" } — then person.name works."), false)
        give mDone
    }
    let g = objGet(b, top.e.name)
    if g.found == false {
        finishFrame(missingField(b, top.e.name, top.e.line), false)
        give mDone
    }
    finishFrame(okVal(g.value), false)
    give mDone
}

make consumeGetIndex(top) {
    if top.stage == 0 {
        top.saved = mResult.value
        top.stage = 1
        pushExpr(top.e.index, top.scope)
        give mDone
    }
    finishFrame(readIndex(top.saved, mResult.value, top.e.line), false)
    give mDone
}

make consumeObjlit(top) {
    objSet(top.obj, top.e.names[top.i], mResult.value)
    top.i = top.i + 1
    if top.i >= length(top.e.names) {
        finishFrame(okVal(top.obj), false)
        give mDone
    }
    pushExpr(top.e.values[top.i], top.scope)
    give mDone
}

make consumeListlit(top) {
    append(top.items, mResult.value)
    top.i = top.i + 1
    if top.i >= length(top.e.items) {
        finishFrame(okVal(vList(top.items)), false)
        give mDone
    }
    pushExpr(top.e.items[top.i], top.scope)
    give mDone
}

// ---------- calls ----------
// A call frame gathers its handed values one at a time
// (stage 0), then either runs a built-in tool on them, or —
// for a function the program made — checks the count and the
// depth, and lays the function's body on the machine as a
// block frame (stage 2) in a fresh scope whose parent is the
// scope the function was made in. When the body finishes, the
// frame turns its outcome into the call's value: a 'give'
// hands its value across (see stepUnwind), a plain finish
// hands back nothing, and an error travels on up.

// Before any value is worked out: a built-in tool's name is
// known at once, and an unknown name is refused at once —
// the interpreter has always answered those before looking
// at the call's values.
make callBegin(frame) {
    if isBuiltinName(frame.name) {
        give mDone
    }
    let idx = nameIndex(gFnNames, frame.name)
    if idx < 0 {
        let message = "I don't know a function called '" + frame.name + "' yet. You can make one with: make " + frame.name + "(...) { ... }"
        let candidates = copyList(gFnNames)
        for b in builtinNamesList() {
            append(candidates, b)
        }
        let close = closestOf(frame.name, candidates)
        if close.found {
            message = message + " Did you mean '" + close.name + "'?"
        }
        give errAt(frame.line, message)
    }
    frame.def = gFnDefs[idx]
    give mDone
}

make stepCallStart(top) {
    if top.stage == 0 {
        if top.nextArg < length(top.argExprs) {
            pushExpr(top.argExprs[top.nextArg], top.scope)
            give mDone
        }
        dispatchCall(top)
        give mDone
    }
    give mDone
}

make consumeCall(top) {
    if top.stage == 0 {
        append(top.values, mResult.value)
        top.nextArg = top.nextArg + 1
        mHasResult = false
        give mDone
    }
    if top.stage == 2 {
        gCallDepth = gCallDepth - 1
        // Stone 19: a function marked 'maybe' that finishes
        // without a 'give' hands back the empty value — that
        // is exactly what the mark says may happen — so the
        // no-give finish is a value for it, and only for it.
        let rk = top.def.returnKind
        if rk != "" {
            if rk != "nothing" {
                if isMaybeKindWord(rk) == false {
                    finishFrame(errAt(top.line, "'" + top.name + "' is marked to give back " + kindPhrase(rk) + " by its annotation, but it finished without giving a value back. Add a 'give' line inside '" + top.name + "', or change the annotation."), false)
                    give mDone
                }
            }
        }
        if top.inExpr {
            if isMaybeKindWord(rk) == false {
                finishFrame(errAt(top.line, "The function '" + top.name + "' finished without giving a value back, so there is nothing to use here. Add a 'give' line inside '" + top.name + "', or call it on its own line instead."), false)
                give mDone
            }
        }
        finishCall(top, okVal(NOTHING))
        give mDone
    }
    give mDone
}

// Every handed value is in: run the tool, or lay the
// function's body on the machine.
make dispatchCall(top) {
    if isBuiltinName(top.name) {
        if length(top.values) != length(builtinParamsOf(top.name)) {
            finishFrame(errAt(top.line, builtinCountText(top.name, length(top.values))), false)
            give mDone
        }
        finishCall(top, runBuiltin(top.name, top.values, top.line))
        give mDone
    }
    let def = top.def
    if length(top.values) != length(def.params) {
        finishFrame(errAt(top.line, "The function '" + top.name + "' takes " + takesText(def.params) + ", but it was given " + length(top.values) + ". Make the call match how the function was made: " + top.name + "(" + join(def.params, ", ") + ")."), false)
        give mDone
    }
    // Stone 18: the guards at the annotated boundaries of
    // the call — each annotated parameter checks the value
    // handed to it, here at the call.
    let pi = 0
    while pi < length(def.params) {
        let kw = def.paramKinds[pi]
        if kw != "" {
            if kindSatisfies(kw, top.values[pi]) == false {
                finishFrame(errAt(top.line, "The value handed to '" + top.name + "' for '" + def.params[pi] + "' is " + described(top.values[pi]) + ", but '" + def.params[pi] + "' is marked as " + kindPhrase(kw) + " by its annotation. Change what the call hands over, or change the annotation."), false)
                give mDone
            }
        }
        pi = pi + 1
    }
    if gCallDepth >= 500 {
        finishFrame(errAt(top.line, "This call is more than five hundred functions deep and was stopped — it may never finish. A function that calls itself needs a way to stop, like an 'if' that gives an answer for the smallest case instead of calling again."), false)
        give mDone
    }
    gCallDepth = gCallDepth + 1
    let callScope = makeScope(def.home)
    let i = 0
    while i < length(def.params) {
        scopeDeclare(callScope, def.params[i], top.values[i])
        if def.paramKinds[i] != "" {
            scopeDeclareAnnotation(callScope, def.params[i], def.paramKinds[i])
        }
        i = i + 1
    }
    top.stage = 2
    pushBlock(def.body, callScope)
    give mDone
}

// The call's outcome. (The check that belongs to the place
// the call was made — a call used as a value needs a value
// back — lives in the two roads that finish a made function:
// consumeCall for a body that ended without a 'give', and
// stepUnwind for one that gave. A built-in tool always hands
// a value back, and since Stone 19 the empty value is a
// value like any other when a function gives it.)
make finishCall(top, r) {
    if r.ok == false {
        finishFrame(r, false)
        give mDone
    }
    finishFrame(r, false)
    give mDone
}



// Checks that a value can pick an item: a whole number. Gives
// back the number itself.
make itemNumber(v, line) {
    if v.kind != "number" {
        give errAt(line, "I can't use " + described(v) + " to pick an item. Items are picked by a whole number — 0 for the first one, 1 for the second, and so on.")
    }
    let bad = false
    if isWholeNum(v.num) == false {
        bad = true
    }
    if v.num >= 1000000000000000 {
        bad = true
    }
    if v.num <= 0 - 1000000000000000 {
        bad = true
    }
    if bad {
        give errAt(line, "An item number must be a whole number, but I was given " + numText(v.num) + ". Use a whole number, like 0, 1, or 2.")
    }
    give okVal(v.num)
}

// Reads one item of a list, or one character of some text.
make readIndex(base, indexValue, line) {
    if base.kind == "list" {
        let num = itemNumber(indexValue, line)
        if num.ok == false {
            give num
        }
        let idx = num.value
        if length(base.items) == 0 {
            give errAt(line, "This list has no items yet, so there is no item " + idx + " to take from it. Items can be added with append — like: append(items, ...).")
        }
        if idx < 0 {
            give errAt(line, "This list has " + length(base.items) + " items, numbered 0 to " + (length(base.items) - 1) + ", but I was asked for item " + idx + ".")
        }
        if idx >= length(base.items) {
            give errAt(line, "This list has " + length(base.items) + " items, numbered 0 to " + (length(base.items) - 1) + ", but I was asked for item " + idx + ".")
        }
        give okVal(base.items[idx])
    }
    if base.kind == "text" {
        let num = itemNumber(indexValue, line)
        if num.ok == false {
            give num
        }
        let idx = num.value
        let chars = []
        for ch in base.text {
            append(chars, ch)
        }
        if length(chars) == 0 {
            give errAt(line, "This text has no characters yet, so there is no character " + idx + " to take from it.")
        }
        if idx < 0 {
            give errAt(line, "This text has " + length(chars) + " characters, numbered 0 to " + (length(chars) - 1) + ", but I was asked for character " + idx + ".")
        }
        if idx >= length(chars) {
            give errAt(line, "This text has " + length(chars) + " characters, numbered 0 to " + (length(chars) - 1) + ", but I was asked for character " + idx + ".")
        }
        give okVal(vText(chars[idx]))
    }
    if base.kind == "bytes" {
        let num = itemNumber(indexValue, line)
        if num.ok == false {
            give num
        }
        let idx = num.value
        if length(base.data) == 0 {
            give errAt(line, "This block of bytes has no bytes yet, so there is no byte " + idx + " to take from it. Make a bigger block with makebytes — like: makebytes(8).")
        }
        if idx < 0 {
            give errAt(line, "This block of bytes has " + length(base.data) + " bytes, numbered 0 to " + (length(base.data) - 1) + ", but I was asked for byte " + idx + ".")
        }
        if idx >= length(base.data) {
            give errAt(line, "This block of bytes has " + length(base.data) + " bytes, numbered 0 to " + (length(base.data) - 1) + ", but I was asked for byte " + idx + ".")
        }
        give okVal(vNumber(base.data[idx]))
    }
    give errAt(line, "I can't take an item from " + described(base) + ". Only a list or some text has items to take from — like [1, 2, 3], where [0] takes the first item, or \"abc\", where [0] takes the first character.")
}

// Reading a field an object doesn't have.
make missingField(obj, name, line) {
    if length(obj.names) == 0 {
        give errAt(line, "This object has no fields yet, so it has no field called '" + name + "'. You can add one by setting it, like: person." + name + " = ...")
    }
    let message = "This object has no field called '" + name + "'. Its fields are: " + join(obj.names, ", ") + "."
    let close = closestOf(name, obj.names)
    if close.found {
        message = message + " Did you mean '" + close.name + "'?"
    }
    give errAt(line, message)
}

// The operators, with the Swift interpreter's rules and words.
make applyOp(op, l, r, line) {
    // Stone 19: when one side is the empty value, the refusal
    // carries the nothing words, as the Swift interpreter's do.
    let note = ""
    if l.kind == "nothing" {
        note = NOTHINGNOTE
    }
    if r.kind == "nothing" {
        note = NOTHINGNOTE
    }
    if op == "+" {
        if l.kind == "text" {
            give okVal(vText(spokenOf(l) + spokenOf(r)))
        }
        if r.kind == "text" {
            give okVal(vText(spokenOf(l) + spokenOf(r)))
        }
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vNumber(l.num + r.num))
            }
        }
        give errAt(line, "I can't add " + described(l) + " and " + described(r) + ". '+' adds two numbers, or joins text together." + note)
    }
    if op == "-" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vNumber(l.num - r.num))
            }
        }
        give errAt(line, "I can't subtract " + described(l) + " and " + described(r) + ". '-' works on two numbers. (Only '+' joins text.)" + note)
    }
    if op == "*" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vNumber(l.num * r.num))
            }
        }
        give errAt(line, "I can't multiply " + described(l) + " and " + described(r) + ". '*' works on two numbers. (Only '+' joins text.)" + note)
    }
    if op == "/" {
        if l.kind == "number" {
            if r.kind == "number" {
                if r.num == 0 {
                    give errAt(line, "I can't divide by zero. Dividing needs a second number that isn't zero.")
                }
                give okVal(vNumber(l.num / r.num))
            }
        }
        give errAt(line, "I can't divide " + described(l) + " and " + described(r) + ". '/' works on two numbers. (Only '+' joins text.)" + note)
    }
    if op == "==" {
        give okVal(vBool(valuesEqual(l, r)))
    }
    if op == "!=" {
        if valuesEqual(l, r) {
            give okVal(vBool(false))
        }
        give okVal(vBool(true))
    }
    if op == "<" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vBool(l.num < r.num))
            }
        }
        give errAt(line, "I can't compare " + described(l) + " and " + described(r) + " with '<'. '<' compares two numbers. (Text and true/false values can be checked with == and !=.)" + note)
    }
    if op == "<=" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vBool(l.num <= r.num))
            }
        }
        give errAt(line, "I can't compare " + described(l) + " and " + described(r) + " with '<='. '<=' compares two numbers. (Text and true/false values can be checked with == and !=.)" + note)
    }
    if op == ">" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vBool(l.num > r.num))
            }
        }
        give errAt(line, "I can't compare " + described(l) + " and " + described(r) + " with '>'. '>' compares two numbers. (Text and true/false values can be checked with == and !=.)" + note)
    }
    if op == ">=" {
        if l.kind == "number" {
            if r.kind == "number" {
                give okVal(vBool(l.num >= r.num))
            }
        }
        give errAt(line, "I can't compare " + described(l) + " and " + described(r) + " with '>='. '>=' compares two numbers. (Text and true/false values can be checked with == and !=.)" + note)
    }
    give errAt(line, "I don't know the sign '" + op + "'.")
}

// Are two values equal? Numbers, text, and true/false by their
// content; objects and lists only when they are the very same
// one — which, for the tagged objects holding them, is what the
// host's == already says.
make valuesEqual(l, r) {
    if l.kind != r.kind {
        give false
    }
    if l.kind == "number" {
        give l.num == r.num
    }
    if l.kind == "text" {
        give l.text == r.text
    }
    if l.kind == "boolean" {
        give l.flag == r.flag
    }
    if l.kind == "object" {
        give l == r
    }
    if l.kind == "list" {
        give l == r
    }
    if l.kind == "bytes" {
        give l == r
    }
    if l.kind == "nothing" {
        // Stone 19: the empty value is equal to itself — that
        // is how a maybe is checked.
        give true
    }
    give false
}

// "no values", "1 value (name)", "2 values (a, b)" — for the
// wrong-number-of-values errors.
make takesText(params) {
    if length(params) == 0 {
        give "no values"
    }
    if length(params) == 1 {
        give "1 value (" + params[0] + ")"
    }
    give length(params) + " values (" + join(params, ", ") + ")"
}

// ---------- the built-in tools ----------
// The tools every Nifla program has from the start, in one
// place: their names, the names of the values they take, and an
// example call of each — for the plain-words messages. The
// Stone 9 and Stone 10 tools joined the table with their
// stones; 'makebytes' and the bytes it makes are mirrored here
// with Stone 10, one stone after the hosted tools learned them.

let gBuiltinNames = ["length", "join", "split", "part", "find", "append", "readfile", "readbytes", "writefile", "arguments", "makebytes", "sayerr", "exitwith", "removeat", "insertat", "sorted", "fieldnames", "removefield"]
let gBuiltinParams = [["value"], ["list", "separator"], ["text", "separator"], ["text", "start", "count"], ["text", "piece"], ["list", "value"], ["path"], ["path"], ["path", "text"], [], ["count"], ["value"], ["code"], ["list", "index"], ["list", "index", "value"], ["list"], ["object"], ["object", "name"]]
let gBuiltinExamples = ["length(\"Tyler\")", "join(words, \" \")", "split(\"a,b\", \",\")", "part(\"Tyler\", 0, 2)", "find(\"Tyler\", \"y\")", "append(items, 4)", "readfile(\"notes.txt\")", "readbytes(\"notes.txt\")", "writefile(\"notes.txt\", \"Shalom\")", "arguments()", "makebytes(8)", "sayerr(\"Mind the step.\")", "exitwith(1)", "removeat(items, 0)", "insertat(items, 0, 4)", "sorted(items)", "fieldnames(person)", "removefield(person, \"town\")"]

make builtinNamesList() {
    give gBuiltinNames
}

make isBuiltinName(name) {
    give nameIndex(gBuiltinNames, name) >= 0
}

make builtinParamsOf(name) {
    give gBuiltinParams[nameIndex(gBuiltinNames, name)]
}

// The message for a call to a tool with the wrong number of
// values — the same shape as the one for made functions.
make builtinCountText(name, given) {
    let params = builtinParamsOf(name)
    let example = gBuiltinExamples[nameIndex(gBuiltinNames, name)]
    give "The tool '" + name + "' takes " + takesText(params) + ", but it was given " + given + ". Call it like: " + example + "."
}

// A whole-number check for the counting tools ('part'): the
// value is already known to be a number; this checks it is a
// whole one and hands the number back.
make wholeCount(v, what, line) {
    if v.kind != "number" {
        give errAt(line, what + " must be a number, but I was given " + described(v) + ".")
    }
    let bad = false
    if isWholeNum(v.num) == false {
        bad = true
    }
    if v.num >= 1000000000000000 {
        bad = true
    }
    if v.num <= 0 - 1000000000000000 {
        bad = true
    }
    if bad {
        give errAt(line, what + " must be a whole number, but I was given " + numText(v.num) + ".")
    }
    give okVal(v.num)
}

// Runs a built-in tool on values already worked out. Where a
// tool's work is exactly a host tool's work — splitting, finding,
// taking a part, reading and writing files — the host tool does
// it, and this interpreter checks the values and wraps the
// answer, in the Swift interpreter's own words.
make runBuiltin(name, args, line) {
    if name == "length" {
        let v = args[0]
        if v.kind == "text" {
            give okVal(vNumber(length(v.text)))
        }
        if v.kind == "list" {
            give okVal(vNumber(length(v.items)))
        }
        if v.kind == "object" {
            give okVal(vNumber(length(v.names)))
        }
        if v.kind == "bytes" {
            give okVal(vNumber(length(v.data)))
        }
        give errAt(line, "'length' measures some text, a list, an object, or a block of bytes, but it was given " + described(v) + ".")
    }
    if name == "join" {
        if args[0].kind != "list" {
            give errAt(line, "'join' joins the items of a list into one piece of text, but it was given " + described(args[0]) + " to join. Give it a list first, like: join(words, \" \").")
        }
        if args[1].kind != "text" {
            give errAt(line, "'join' needs some text to join the items with, like \" \" or \", \", but it was given " + described(args[1]) + ".")
        }
        let parts = []
        for item in args[0].items {
            append(parts, spokenOf(item))
        }
        give okVal(vText(join(parts, args[1].text)))
    }
    if name == "split" {
        if args[0].kind != "text" {
            give errAt(line, "'split' splits some text into a list of pieces, but it was given " + described(args[0]) + " to split.")
        }
        if args[1].kind != "text" {
            give errAt(line, "'split' needs some text to split by, like \",\", but it was given " + described(args[1]) + ".")
        }
        if length(args[1].text) == 0 {
            give errAt(line, "'split' can't split by an empty piece of text — there would be nothing to split on. Give it the text to split by, like: split(\"a,b\", \",\").")
        }
        let out = []
        for piece in split(args[0].text, args[1].text) {
            append(out, vText(piece))
        }
        give okVal(vList(out))
    }
    if name == "part" {
        if args[0].kind != "text" {
            give errAt(line, "'part' takes a part of some text, but it was given " + described(args[0]) + ".")
        }
        if args[1].kind != "number" {
            give errAt(line, "'part' needs a number saying which character to start at — 0 is the first — but it was given " + described(args[1]) + ".")
        }
        if args[2].kind != "number" {
            give errAt(line, "'part' needs a number saying how many characters to take, but it was given " + described(args[2]) + ".")
        }
        let startR = wholeCount(args[1], "The character to start at", line)
        if startR.ok == false {
            give startR
        }
        let countR = wholeCount(args[2], "The number of characters to take", line)
        if countR.ok == false {
            give countR
        }
        let start = startR.value
        let count = countR.value
        let total = length(args[0].text)
        if start < 0 {
            give errAt(line, "'part' was told to start at character " + start + ", but the first character is number 0 — a start can't be less than 0.")
        }
        if count < 0 {
            give errAt(line, "'part' was told to take " + count + " characters, but a count can't be less than 0.")
        }
        if start > total {
            if total == 0 {
                give errAt(line, "'part' was told to start at character " + start + ", but the text has no characters yet.")
            }
            give errAt(line, "'part' was told to start at character " + start + ", but the text has only " + total + " characters, numbered 0 to " + (total - 1) + ".")
        }
        if start + count > total {
            give errAt(line, "'part' was told to take " + count + " characters starting at character " + start + ", but the text has only " + total + " characters, numbered 0 to " + (total - 1) + " — that runs past the end.")
        }
        give okVal(vText(part(args[0].text, start, count)))
    }
    if name == "find" {
        if args[0].kind != "text" {
            give errAt(line, "'find' looks for a piece of text inside some text, but it was given " + described(args[0]) + " to look in.")
        }
        if args[1].kind != "text" {
            give errAt(line, "'find' looks for a piece of text inside some text, but it was given " + described(args[1]) + " to look for.")
        }
        give okVal(vNumber(find(args[0].text, args[1].text)))
    }
    if name == "append" {
        if args[0].kind != "list" {
            give errAt(line, "'append' adds a value to the end of a list, but it was given " + described(args[0]) + " to add to.")
        }
        append(args[0].items, args[1])
        give okVal(args[0])
    }
    if name == "readfile" {
        if args[0].kind != "text" {
            give errAt(line, "'readfile' needs the name of a file, as text, but it was given " + described(args[0]) + ".")
        }
        // The host's own readfile speaks with the host's line
        // numbers when it fails; catch its problem (Stone 10)
        // and say it again with the interpreted program's line,
        // the way the Swift interpreter says it.
        let contents = ""
        attempt {
            contents = readfile(args[0].text)
        } if it fails {
            give errAt(line, problem)
        }
        give okVal(vText(contents))
    }
    if name == "readbytes" {
        if args[0].kind != "text" {
            give errAt(line, "'readbytes' needs the name of a file, as text, but it was given " + described(args[0]) + ".")
        }
        // Stone 25: the host's readbytes gives a block of
        // bytes; this interpreter's bytes are a list of byte
        // values (the vBytes shape), so the block is unpacked
        // into that shape here. The host's failure is caught
        // and re-said with this program's line, as readfile's
        // is above.
        let block = makebytes(0)
        attempt {
            block = readbytes(args[0].text)
        } if it fails {
            give errAt(line, problem)
        }
        let data = []
        let i = 0
        while i < length(block) {
            append(data, block[i])
            i = i + 1
        }
        give okVal(vBytes(data))
    }
    if name == "writefile" {
        if args[0].kind != "text" {
            give errAt(line, "'writefile' needs the name of a file, as text, but it was given " + described(args[0]) + ".")
        }
        if args[1].kind != "text" {
            give errAt(line, "'writefile' writes some text to a file, but it was given " + described(args[1]) + " to write.")
        }
        let written = 0
        attempt {
            written = writefile(args[0].text, args[1].text)
        } if it fails {
            give errAt(line, problem)
        }
        give okVal(vNumber(written))
    }
    if name == "arguments" {
        let out = []
        for a in gArgs {
            append(out, vText(a))
        }
        give okVal(vList(out))
    }
    if name == "makebytes" {
        if args[0].kind != "number" {
            give errAt(line, "The number of bytes to make must be a number, but I was given " + described(args[0]) + ".")
        }
        if isWholeNum(args[0].num) == false {
            give errAt(line, "The number of bytes to make must be a whole number, but I was given " + numText(args[0].num) + ".")
        }
        let count = args[0].num
        if count < 0 {
            give errAt(line, "'makebytes' was told to make " + count + " bytes, but a count can't be less than 0.")
        }
        if count > 16777216 {
            give errAt(line, "'makebytes' was told to make " + count + " bytes, but one block can hold at most 16777216 bytes.")
        }
        let data = []
        repeat count {
            append(data, 0)
        }
        give okVal(vBytes(data))
    }
    if name == "sayerr" {
        let spoken = spokenOf(args[0])
        sayerr(spoken)
        give okVal(vNumber(length(spoken) + 1))
    }
    if name == "exitwith" {
        if args[0].kind != "number" {
            give errAt(line, "'exitwith' ends the program with a number as its parting word to the system, but it was given " + described(args[0]) + ".")
        }
        let code = args[0].num
        if isWholeNum(code) == false {
            give errAt(line, "'exitwith' needs a whole number from 0 to 255, but it was given " + numText(code) + ".")
        }
        if code < 0 {
            give errAt(line, "'exitwith' needs a whole number from 0 to 255, but it was given " + numText(code) + ".")
        }
        if code > 255 {
            give errAt(line, "'exitwith' needs a whole number from 0 to 255, but it was given " + numText(code) + ".")
        }
        exitwith(code)
        give okVal(NOTHING)
    }
    if name == "removeat" {
        if args[0].kind != "list" {
            give errAt(line, "'removeat' takes an item out of a list, but it was given " + described(args[0]) + " to take from.")
        }
        let num = itemNumber(args[1], line)
        if num.ok == false {
            give num
        }
        let idx = num.value
        if length(args[0].items) == 0 {
            give errAt(line, "This list has no items yet, so there is no item " + idx + " to remove.")
        }
        if idx < 0 {
            give errAt(line, "This list has " + length(args[0].items) + " items, numbered 0 to " + (length(args[0].items) - 1) + ", but I was asked to remove item " + idx + ".")
        }
        if idx >= length(args[0].items) {
            give errAt(line, "This list has " + length(args[0].items) + " items, numbered 0 to " + (length(args[0].items) - 1) + ", but I was asked to remove item " + idx + ".")
        }
        give okVal(removeat(args[0].items, idx))
    }
    if name == "insertat" {
        if args[0].kind != "list" {
            give errAt(line, "'insertat' puts an item into a list, but it was given " + described(args[0]) + " to put into.")
        }
        let num = itemNumber(args[1], line)
        if num.ok == false {
            give num
        }
        let idx = num.value
        if idx < 0 {
            give errAt(line, "This list has " + length(args[0].items) + " items, so a new item can be put in at numbers 0 to " + length(args[0].items) + ", but I was asked for number " + idx + ".")
        }
        if idx > length(args[0].items) {
            give errAt(line, "This list has " + length(args[0].items) + " items, so a new item can be put in at numbers 0 to " + length(args[0].items) + ", but I was asked for number " + idx + ".")
        }
        insertat(args[0].items, idx, args[2])
        give okVal(args[0])
    }
    if name == "sorted" {
        if args[0].kind != "list" {
            give errAt(line, "'sorted' sorts a list, but it was given " + described(args[0]) + " to sort.")
        }
        let items = args[0].items
        if length(items) == 0 {
            give okVal(vList([]))
        }
        let first = items[0]
        if first.kind == "number" {
            let i = 0
            while i < length(items) {
                if items[i].kind != "number" {
                    give errAt(line, "'sorted' needs every item in the list to be the same kind — numbers with numbers, text with text — but item " + i + " is " + described(items[i]) + ", while the first item is " + described(first) + ".")
                }
                i = i + 1
            }
            let raw = []
            for item in items {
                append(raw, item.num)
            }
            let ordered = sorted(raw)
            let wrapped = []
            for n in ordered {
                append(wrapped, vNumber(n))
            }
            give okVal(vList(wrapped))
        }
        if first.kind == "text" {
            let i = 0
            while i < length(items) {
                if items[i].kind != "text" {
                    give errAt(line, "'sorted' needs every item in the list to be the same kind — numbers with numbers, text with text — but item " + i + " is " + described(items[i]) + ", while the first item is " + described(first) + ".")
                }
                i = i + 1
            }
            let raw = []
            for item in items {
                append(raw, item.text)
            }
            let ordered = sorted(raw)
            let wrapped = []
            for t in ordered {
                append(wrapped, vText(t))
            }
            give okVal(vList(wrapped))
        }
        give errAt(line, "'sorted' can sort a list of numbers or a list of text, but this list starts with " + described(first) + ".")
    }
    if name == "fieldnames" {
        if args[0].kind != "object" {
            give errAt(line, "'fieldnames' lists the field names of an object, as a list of text, but it was given " + described(args[0]) + ".")
        }
        let out = []
        for fieldName in args[0].names {
            append(out, vText(fieldName))
        }
        give okVal(vList(out))
    }
    if name == "removefield" {
        if args[0].kind != "object" {
            give errAt(line, "'removefield' takes a field out of an object, but it was given " + described(args[0]) + " to take from.")
        }
        if args[1].kind != "text" {
            give errAt(line, "'removefield' needs the name of a field, as text, but it was given " + described(args[1]) + ".")
        }
        let i = nameIndex(args[0].names, args[1].text)
        if i < 0 {
            give missingField(args[0], args[1].text, line)
        }
        let removed = args[0].values[i]
        removeat(args[0].names, i)
        removeat(args[0].values, i)
        give okVal(removed)
    }
    give errAt(line, "I don't know a tool called '" + name + "'.")
}

// ---------- the floor scan ----------
// Finds the first floor block in a program, wherever it is
// nested, so a program holding floor code is refused before
// anything runs — the interpreter can't run it at all.

make firstFloorInStmts(stmts) {
    for s in stmts {
        let r = firstFloorInStmt(s)
        if r.found {
            give r
        }
    }
    give { found: false, line: 0 }
}

make firstFloorInStmt(s) {
    if s.type == "declare" {
        give firstFloorInExpr(s.value)
    }
    if s.type == "assign" {
        give firstFloorInExpr(s.value)
    }
    if s.type == "assignTarget" {
        let r = firstFloorInExpr(s.target)
        if r.found {
            give r
        }
        give firstFloorInExpr(s.value)
    }
    if s.type == "say" {
        give firstFloorInExpr(s.value)
    }
    if s.type == "give" {
        give firstFloorInExpr(s.value)
    }
    if s.type == "attempt" {
        let r = firstFloorInStmts(s.body)
        if r.found {
            give r
        }
        give firstFloorInStmts(s.recovery)
    }
    if s.type == "if" {
        let r = firstFloorInExpr(s.condition)
        if r.found {
            give r
        }
        let r2 = firstFloorInStmts(s.thenStmts)
        if r2.found {
            give r2
        }
        give firstFloorInStmts(s.elseStmts)
    }
    if s.type == "while" {
        let r = firstFloorInExpr(s.condition)
        if r.found {
            give r
        }
        give firstFloorInStmts(s.body)
    }
    if s.type == "repeat" {
        let r = firstFloorInExpr(s.count)
        if r.found {
            give r
        }
        give firstFloorInStmts(s.body)
    }
    if s.type == "for" {
        let r = firstFloorInExpr(s.over)
        if r.found {
            give r
        }
        give firstFloorInStmts(s.body)
    }
    if s.type == "define" {
        give firstFloorInStmts(s.body)
    }
    if s.type == "doCall" {
        for a in s.args {
            let r = firstFloorInExpr(a)
            if r.found {
                give r
            }
        }
        give { found: false, line: 0 }
    }
    if s.type == "doExpr" {
        give firstFloorInExpr(s.expr)
    }
    give { found: false, line: 0 }
}

make firstFloorInExpr(e) {
    if e.type == "floor" {
        for a in e.args {
            let r = firstFloorInExpr(a)
            if r.found {
                give r
            }
        }
        give { found: true, line: e.line }
    }
    if e.type == "call" {
        for a in e.args {
            let r = firstFloorInExpr(a)
            if r.found {
                give r
            }
        }
        give { found: false, line: 0 }
    }
    if e.type == "object" {
        for v in e.values {
            let r = firstFloorInExpr(v)
            if r.found {
                give r
            }
        }
        give { found: false, line: 0 }
    }
    if e.type == "list" {
        for item in e.items {
            let r = firstFloorInExpr(item)
            if r.found {
                give r
            }
        }
        give { found: false, line: 0 }
    }
    if e.type == "field" {
        give firstFloorInExpr(e.base)
    }
    if e.type == "negate" {
        give firstFloorInExpr(e.inner)
    }
    if e.type == "index" {
        let r = firstFloorInExpr(e.base)
        if r.found {
            give r
        }
        give firstFloorInExpr(e.index)
    }
    if e.type == "binary" {
        let r = firstFloorInExpr(e.left)
        if r.found {
            give r
        }
        give firstFloorInExpr(e.right)
    }
    give { found: false, line: 0 }
}

// ---------- the program itself ----------
// What running this interpreter does: take the program's path
// from the first word it was started with, hand the rest of the
// words to the program as its arguments, read the program, take
// it apart, refuse it if it holds floor code, and run it. A
// problem at any step is said in the same plain words the Swift
// interpreter would print — on the error channel, since Stone
// 10 gave programs one, leaving with the same parting numbers:
// 2 when the program file itself can't be opened, 1 when the
// program is refused or goes wrong. (Before Stone 10 these
// problems were said on the screen and the interpreter left
// with 0; the Swift one never did either of those.)

let allArgs = arguments()
if length(allArgs) == 0 {
    say "Give me a Nifla program to run, like: nifla-in-nifla program.nifla"
} else {
    let path = allArgs[0]
    let argi = 1
    while argi < length(allArgs) {
        append(gArgs, allArgs[argi])
        argi = argi + 1
    }
    let source = ""
    attempt {
        source = readfile(path)
    } if it fails {
        sayerr("I couldn't open the file '" + path + "'. Check the name and the folder, and try again.")
        exitwith(2)
    }
    let lexed = lexAll(source)
    if lexed.ok == false {
        sayerr(lexed.message)
        exitwith(1)
    } else {
        let parsed = parseProgramAll(lexed.value)
        if parsed.ok == false {
            sayerr(parsed.message)
            exitwith(1)
        } else {
            let fl = firstFloorInStmts(parsed.value)
            if fl.found {
                sayerr("Line " + fl.line + ": This is floor code — raw instructions for the processor — and the interpreter can't run it. Floor code runs only in a compiled program: build this program with niflac and run the program it makes.")
                exitwith(1)
            } else {
                let r = runProgram(parsed.value)
                if r.ok == false {
                    sayerr(r.message)
                    exitwith(1)
                }
            }
        }
    }
}
