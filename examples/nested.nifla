// Loops inside a loop: a tiny multiplication table. The 'if' adds
// the spaces between the numbers, but not after the last one.
let row = 1
while row <= 3 {
    let text = ""
    let col = 1
    while col <= 3 {
        text = text + (row * col)
        if col < 3 {
            text = text + " "
        }
        col = col + 1
    }
    say text
    row = row + 1
}
