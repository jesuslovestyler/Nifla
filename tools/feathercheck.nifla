// feathercheck, written in Nifla (Stone 25) — the
// toolchain's first self-made tool: the Stone 21 feather
// checker rewritten in the language itself, and compiled
// by niflac into a standalone program like any other.
//
// It reads a .feather file and answers in plain words
// whether its card is true — the name, what it needs, the
// byte count and checksum the card states, the byte count
// and checksum the program as it stands reckons to, and
// a clear verdict line. Its words are the hosted
// checker's words, line for line; run-selfmade.sh proves
// the two agree across the feather corpus.
//
// Two pieces of craft the writing needed, named plainly:
//
//   - The file is read with readbytes (this stone's
//     addition to the toolbox): a feather's program bytes
//     are not text, and readfile honestly refuses them.
//
//   - The FNV-1a-64 reckoning is done in 16-bit limbs.
//     Nifla's numbers are whole exactly up to 2^53, and a
//     64-bit hash times its prime is more than that, so
//     the hash is carried as four limbs of 16 bits each
//     and the multiplication is done limb by limb — every
//     product and carry stays small enough to be exact.
//     Two small helpers do the work the language has no
//     single word for: floordiv reads a whole-number
//     quotient off a division's spoken form, and xorbyte
//     works a byte's XOR out bit by bit.

// The whole-number quotient of n divided by d, for whole
// n >= 0 and d > 0. '/' gives the true quotient with its
// fraction, and the language has no rounding tool, so
// the whole part is read off the quotient's spoken form:
// for n >= d the quotient is at least 1 and speaks
// plainly (never in the e-notation small fractions use);
// for n < d the answer is 0, said directly.
make floordiv(n, d) {
    if n < d {
        give 0
    }
    let q = n / d
    let t = "" + q
    let dot = find(t, ".")
    if dot == -1 {
        give q
    }
    let whole = part(t, 0, dot)
    let v = 0
    let i = 0
    while i < length(whole) {
        v = v * 10 + find("0123456789", part(whole, i, 1))
        i = i + 1
    }
    give v
}

// The XOR of two byte values (each 0 to 255), worked out
// bit by bit: a bit is in the answer when it is in one
// byte and not the other.
make xorbyte(a, b) {
    let out = 0
    let place = 1
    let aa = a
    let bb = b
    repeat 8 {
        let ah = floordiv(aa, 2)
        let bh = floordiv(bb, 2)
        if aa - 2 * ah != bb - 2 * bh {
            out = out + place
        }
        aa = ah
        bb = bh
        place = place * 2
    }
    give out
}

// One step of the FNV-1a-64 reckoning: h is the hash as
// four 16-bit limbs, little-endian ([l0, l1, l2, l3]),
// and b is the next byte. The byte is XORed into the
// low limb, then the hash is multiplied by the prime
// 0x100000001b3 — whose own limbs are 435, 0, 256, 0,
// so only two multiplications per limb are needed.
make fnvstep(h, b) {
    let low = h[0] - 256 * floordiv(h[0], 256)
    let h0 = h[0] - low + xorbyte(low, b)
    let r0 = h0 * 435
    let c0 = floordiv(r0, 65536)
    let l0 = r0 - c0 * 65536
    let r1 = h[1] * 435 + c0
    let c1 = floordiv(r1, 65536)
    let l1 = r1 - c1 * 65536
    let r2 = h[2] * 435 + h0 * 256 + c1
    let c2 = floordiv(r2, 65536)
    let l2 = r2 - c2 * 65536
    let r3 = h[3] * 435 + h[1] * 256 + c2
    let l3 = r3 - floordiv(r3, 65536) * 65536
    give [l0, l1, l2, l3]
}

// The hash as sixteen lowercase hex letters, the way a
// card states it: each limb gives four letters.
make hexof(h) {
    let digits = "0123456789abcdef"
    let out = ""
    let li = 3
    while li >= 0 {
        let l = h[li]
        let d1 = floordiv(l, 4096)
        l = l - d1 * 4096
        let d2 = floordiv(l, 256)
        l = l - d2 * 256
        let d3 = floordiv(l, 16)
        let d4 = l - d3 * 16
        out = out + part(digits, d1, 1) + part(digits, d2, 1) + part(digits, d3, 1) + part(digits, d4, 1)
        li = li - 1
    }
    give out
}

// h * 16 + digit, limb by limb — how a stated checksum's
// letters are gathered into limbs for the comparison.
make shiftadd(h, digit) {
    let l3 = h[3] * 16 + floordiv(h[2], 4096)
    let l2 = (h[2] - 4096 * floordiv(h[2], 4096)) * 16 + floordiv(h[1], 4096)
    let l1 = (h[1] - 4096 * floordiv(h[1], 4096)) * 16 + floordiv(h[0], 4096)
    let l0 = (h[0] - 4096 * floordiv(h[0], 4096)) * 16 + digit
    give [l0, l1, l2, l3]
}

// The printable characters, byte values 32 to 126 in
// order — how a card line's bytes become text. A byte
// outside that range makes the line not clean: the card
// is plain text, so such a line is a damaged one.
let printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

// The line of a block of bytes starting at 'start': its
// text, whether every byte was a printable character,
// and where the next line begins. Gives an object with
// found = false when no newline remains in the block.
make lineat(block, start) {
    let total = length(block)
    let i = start
    while i < total {
        if block[i] == 10 {
            let t = ""
            let clean = true
            let j = start
            while j < i {
                let b = block[j]
                if b >= 32 {
                    if b <= 126 {
                        t = t + part(printable, b - 32, 1)
                    } else {
                        clean = false
                    }
                } else {
                    clean = false
                }
                j = j + 1
            }
            give { found: true, text: t, clean: clean, next: i + 1 }
        }
        i = i + 1
    }
    give { found: false, text: "", clean: false, next: total }
}

// The refusal every damaged card gets: the line, and the
// program ends with the not-whole code.
make damaged(reason) {
    say "This is not a whole feather: " + reason
    exitwith(1)
}

// ---------- the check itself ----------

let args = arguments()
if length(args) != 1 {
    sayerr("Usage: feathercheck <file.feather>")
    exitwith(2)
}
let path = args[0]

let block = makebytes(0)
let read = true
attempt {
    block = readbytes(path)
} if it fails {
    read = false
}
if read == false {
    damaged("the file '" + path + "' could not be read.")
}
let total = length(block)

let first = lineat(block, 0)
if first.found == false {
    damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
}
if first.clean == false {
    damaged("the card's first line is not CARDNULL FEATHER 1 — this file does not carry a feather's card.")
}
if first.text != "CARDNULL FEATHER 1" {
    damaged("the card's first line is not CARDNULL FEATHER 1 — this file does not carry a feather's card.")
}

let name = ""
let hasName = false
let needs = ""
let hasNeeds = false
let statedBytes = 0
let hasBytes = false
let statedSumText = ""
let statedSum = [0, 0, 0, 0]
let hasSum = false
let programStart = -1

let p = first.next
let cardDone = false
while cardDone == false {
    if p >= total {
        cardDone = true
    } else {
        if block[p] == 10 {
            programStart = p + 1
            cardDone = true
        } else {
            let lb = lineat(block, p)
            if lb.found == false {
                damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
            }
            let line = lb.text
            if length(line) >= 6 {
                if part(line, 0, 6) == "name: " {
                    name = part(line, 6, length(line) - 6)
                    hasName = true
                }
            }
            if length(line) >= 7 {
                if part(line, 0, 7) == "needs: " {
                    needs = part(line, 7, length(line) - 7)
                    hasNeeds = true
                }
            }
            if length(line) >= 7 {
                if part(line, 0, 7) == "bytes: " {
                    let tail = part(line, 7, length(line) - 7)
                    if length(tail) == 0 {
                        damaged("the card's 'bytes:' line does not carry a whole number.")
                    }
                    let value = 0
                    let ti = 0
                    while ti < length(tail) {
                        let d = find("0123456789", part(tail, ti, 1))
                        if d == -1 {
                            damaged("the card's 'bytes:' line does not carry a whole number.")
                        }
                        value = value * 10 + d
                        ti = ti + 1
                    }
                    statedBytes = value
                    hasBytes = true
                }
            }
            if length(line) >= 10 {
                if part(line, 0, 10) == "checksum: " {
                    let tail = part(line, 10, length(line) - 10)
                    if length(tail) != 16 {
                        damaged("the card's 'checksum:' line is not sixteen hex letters.")
                    }
                    let limbs = [0, 0, 0, 0]
                    let ti = 0
                    while ti < 16 {
                        let v = find("0123456789abcdefABCDEF", part(tail, ti, 1))
                        if v == -1 {
                            damaged("the card's 'checksum:' line is not sixteen hex letters.")
                        }
                        let d = v
                        if v >= 16 {
                            d = v - 6
                        }
                        limbs = shiftadd(limbs, d)
                        ti = ti + 1
                    }
                    statedSumText = tail
                    statedSum = limbs
                    hasSum = true
                }
            }
            p = lb.next
        }
    }
}

if programStart == -1 {
    damaged("the card never ends — its blank line never comes, so where the program begins cannot be told.")
}
if hasName == false {
    damaged("the card has no 'name:' line.")
}
if hasNeeds == false {
    damaged("the card has no 'needs:' line.")
}
if hasBytes == false {
    damaged("the card has no 'bytes:' line, so the program's length cannot be checked.")
}
if hasSum == false {
    damaged("the card has no 'checksum:' line, so the program's wholeness cannot be checked.")
}

// The reckoning: FNV-1a-64 over the program bytes, from
// the offset basis 0xcbf29ce484222325 — in limbs,
// [8997, 33826, 40164, 52210].
let h = [8997, 33826, 40164, 52210]
let i = programStart
while i < total {
    h = fnvstep(h, block[i])
    i = i + 1
}
let reckonedText = hexof(h)
let programBytes = total - programStart

say "Feather: " + name
say "Needs: " + needs
say "The card says the program is " + statedBytes + " bytes, with checksum " + statedSumText + "."
say "The program as it stands is " + programBytes + " bytes, with checksum " + reckonedText + "."

let cardTrue = false
if programBytes == statedBytes {
    if h[0] == statedSum[0] {
        if h[1] == statedSum[1] {
            if h[2] == statedSum[2] {
                if h[3] == statedSum[3] {
                    cardTrue = true
                }
            }
        }
    }
}
if cardTrue {
    say "The card is true: the program is whole, and a door may let this feather in."
    exitwith(0)
}
say "The card is not true: the program does not match its card, so a door must refuse this feather."
exitwith(1)
