// The hosted toolbox words that stand on bare metal,
// proved on the emulated screen: each stone that brings
// a word to bare metal adds its line here. Stone 34
// brought 'absolute' — a number's size, never below
// nothing — the word the calculator feather had been
// building by hand as 'absn'. Stone 35 brought
// 'smallest' and 'largest', the choosing pair the
// kernel had been spelling out with 'if's wherever it
// keeps a window on the desktop. Stone 36 brought the
// bit words — 'bitand', 'bitor', 'bitxor' — which the
// kernel's USB work had been reaching through a floor
// block wrapped around a single AND. Stone 37 brought
// 'leftover' — what a dividing leaves — which the
// kernel's clock prelude had been spelling longhand,
// subtracting the quotient times the divisor at every
// face it draws; the line below also shows the
// remainder carrying the divided number's sign.
// Stone 38 brought 'wholediv' — on bare metal the
// word names the machine's own division, which never
// had a fraction to drop; its line shows the quotient
// dropped toward zero for a negative number too.
// Stone 39 brought 'asnumber' — reading a number out
// of text — which the feather door had been doing by
// hand, byte by byte; its line reads a plain number,
// a number below zero, and a fraction whose digits
// are all zero, which names a whole number exactly.
// Stone 44 brought 'astext' — reading text out of a
// block of bytes — the road back the feather door
// had been walking by hand, building its letters one
// by one; its line reads a plain word out of its
// bytes here, and the word's whole reckoning (the
// replacement mark for bytes that are not a letter,
// in all its shapes) is proved byte for byte by
// bare-examples/nifla-astext.nifla in this script's
// fifth and sixth parts.
say "absolute " + absolute(0 - 7)
say "smallest " + smallest(9, 4) + " largest " + largest(9, 4)
say "bits " + bitand(12, 10) + " " + bitor(12, 10) + " " + bitxor(12, 10)
say "leftover " + leftover(17, 5) + " " + leftover(0 - 17, 5)
say "wholediv " + wholediv(17, 5) + " " + wholediv(0 - 17, 5)
say "asnumber " + asnumber("620") + " " + asnumber("-42") + " " + asnumber("3.0")
let word = makebytes(6)
word[0] = 83
word[1] = 104
word[2] = 97
word[3] = 108
word[4] = 111
word[5] = 109
say "astext " + astext(word)
say "Bare tools"
